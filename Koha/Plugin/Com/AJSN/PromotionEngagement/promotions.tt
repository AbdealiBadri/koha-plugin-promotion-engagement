[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% USE KohaDates %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]

[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: Promotions</title>
[% INCLUDE 'doc-head-close.inc' %]
<style>
main>h1{font-family:Georgia,serif;color:#17324d}main>.lead{color:#58717c;max-width:920px}
.panel-default{border-color:#d8e1e5;border-radius:6px;box-shadow:0 2px 8px rgba(23,50,77,.05)}
.panel-default>.panel-heading{background:#f1f5f6;color:#17324d;border-color:#d8e1e5;padding:12px 15px}
.table>thead>tr>th{background:#f8fafb;color:#294d5b}.btn-primary{background:#245b64;border-color:#1c4d55}.btn-primary:hover{background:#17324d;border-color:#17324d}

/* Shared professional interaction treatment */
.btn-primary{background:#245b64!important;border-color:#1c4d55!important;color:#fff!important;font-weight:700;box-shadow:0 2px 5px rgba(23,50,77,.18)}
.btn-primary:hover,.btn-primary:focus{background:#17324d!important;border-color:#17324d!important;color:#fff!important}
.btn-default{background:#fff!important;border:1px solid #91a5ad!important;color:#17324d!important;font-weight:700;box-shadow:0 1px 3px rgba(23,50,77,.10)}
.btn-default:hover,.btn-default:focus{background:#edf4f4!important;border-color:#245b64!important;color:#102c43!important}
.btn-danger{color:#fff!important;font-weight:700}.btn i{margin-right:4px}
#toolbar,.btn-group,.export-bar{margin-bottom:18px}.table{background:#fff}.table>thead>tr>th{border-bottom:2px solid #9db2ba!important}
.table>tbody>tr:hover{background:#eef5f5!important}.table td,.table th{vertical-align:middle!important}
.sidebar_menu ul{border:1px solid #d8e1e5;border-radius:7px;overflow:hidden;background:#fff;box-shadow:0 2px 8px rgba(23,50,77,.06)}
.sidebar_menu ul li a{display:block;padding:11px 13px;color:#17324d!important;font-weight:700;border-left:4px solid transparent}
.sidebar_menu ul li a:hover,.sidebar_menu ul li a:focus{background:#edf4f4;text-decoration:none;border-left-color:#2d7372}
.sidebar_menu ul li.active a{background:#e5f0ef!important;color:#17324d!important;border-left-color:#2d7372!important}
.form-control:focus,input:focus,select:focus,textarea:focus{border-color:#2d7372!important;box-shadow:0 0 0 2px rgba(45,115,114,.15)!important}
.panel-heading strong{letter-spacing:.01em}.required{color:#8a2f39!important;font-weight:700}
</style>
[% INCLUDE "$PLUGIN_DIR/promoeng_ui_css.inc" %]
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
        [% END %]
        [% WRAPPER breadcrumb_item %]
            <a href="?class=[% CLASS %]&method=[% METHOD %]">Promotion &amp; Engagement</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active=1 %]
            <span>Promotions</span>
        [% END %]
    [% END %]
[% END %]

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-10 col-sm-push-2">
            <main>
                [% SET promo_help_page = 'promotions' %]
                [% INCLUDE "$PLUGIN_DIR/how_to_use.tt" %]
                <div id="toolbar" class="btn-toolbar">
                    <a class="btn btn-primary" href="?class=[% CLASS %]&method=[% METHOD %]&action=new_promotion">
                        <i class="fa fa-plus"></i> New promotion
                    </a>
                </div>

                <div style="background:linear-gradient(135deg,#17324d,#245b64);color:#fff;border-radius:8px;padding:22px 26px;margin-bottom:20px">
                    <h1 style="color:#fff;margin-top:0">Promotion portfolio</h1>
                    <p style="color:#dcebed;margin-bottom:0;font-size:1.05rem">Search, review and manage the library's evidence-linked engagement campaigns.</p>
                </div>

                [% IF success_message %]
                    <div class="alert alert-success">[% success_message | html %]</div>
                [% END %]

                [% IF error_message %]
                    <div class="alert alert-danger">[% error_message | html %]</div>
                [% END %]

                <div class="panel panel-default">
                    <div class="panel-heading"><strong>Find campaigns</strong></div>
                    <div class="panel-body">
                        <form method="get" action="/cgi-bin/koha/plugins/run.pl">
                            <input type="hidden" name="class" value="[% CLASS | html %]">
                            <input type="hidden" name="method" value="[% METHOD | html %]">
                            <input type="hidden" name="action" value="promotions">
                            <div class="row">
                                <div class="col-md-4">
                                    <label for="promo-q">Search campaign name or notes</label>
                                    <input id="promo-q" name="q" type="search" class="form-control" value="[% search_query | html %]" placeholder="Type a word or phrase">
                                </div>
                                <div class="col-md-5">
                                    <label for="promo-campaigns">Campaign selection</label>
                                    <select id="promo-campaigns" name="campaign_ids" multiple class="form-control promo-searchable-select" data-natural-sort="1" data-placeholder="Type a campaign name, e.g. Week 26">
                                        [% FOREACH choice IN campaign_choices %]
                                            <option value="[% choice.campaign_id %]"[% IF choice.selected %] selected[% END %]>[% choice.name | html %] ([% choice.start_date | html %])</option>
                                        [% END %]
                                    </select>
                                    <p class="promo-dt-note">Type to search. Select one campaign to narrow the list, or several campaigns to compare them.</p>
                                </div>
                                <div class="col-md-3">
                                    <label for="promo-status">Status</label>
                                    <select id="promo-status" name="status" class="form-control promo-searchable-select" data-placeholder="All statuses">
                                        <option value="">All statuses</option>
                                        <option value="draft"[% IF status_filter == 'draft' %] selected="selected"[% END %]>Draft</option>
                                        <option value="active"[% IF status_filter == 'active' %] selected="selected"[% END %]>Active</option>
                                        <option value="completed"[% IF status_filter == 'completed' %] selected="selected"[% END %]>Completed</option>
                                    </select>
                                </div>
                            </div>
                            <div style="margin-top:12px">
                                <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Apply filters</button>
                                <button type="button" class="btn btn-default" data-promo-compare-selected="#promo-campaigns" data-class="[% CLASS | html %]" data-method="[% METHOD | html %]"><i class="fa fa-bar-chart"></i> Compare selected campaigns</button>
                                [% IF search_query || status_filter || selected_campaign_count %]<a class="btn btn-default" href="?class=[% CLASS %]&method=[% METHOD %]&action=promotions"><i class="fa fa-times"></i> Clear</a>[% END %]
                            </div>
                        </form>
                    </div>
                </div>

                <h2 style="font-family:Georgia,serif;color:#17324d;margin:8px 0 14px">Portfolio performance at a glance</h2>
                <div class="row">
                    <div class="col-md-2 col-sm-4"><div class="metric-card"><div class="metric-label">Campaigns in view</div><div class="metric-value">[% campaigns.size %]</div><div class="metric-help">[% filtered_active_count %] active in this view</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card teal"><div class="metric-label">Promoted titles</div><div class="metric-value">[% IF promotions_portfolio %][% promotions_portfolio.promoted_title_count %][% ELSE %]0[% END %]</div><div class="metric-help">Distinct bibliographic titles</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card blue"><div class="metric-label">Titles Issued / Borrowed</div><div class="metric-value">[% IF promotions_portfolio %][% promotions_portfolio.titles_used_count %][% ELSE %]0[% END %]</div><div class="metric-help">Promoted titles with circulation</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card"><div class="metric-label">Title utilization</div><div class="metric-value">[% IF promotions_utilization_display %][% promotions_utilization_display %]%[% ELSE %]—[% END %]</div><div class="metric-help">Share of promoted titles borrowed</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card teal"><div class="metric-label">Campaign checkouts</div><div class="metric-value">[% IF promotions_portfolio %][% promotions_portfolio.portfolio_campaign_checkout_count %][% ELSE %]0[% END %]</div><div class="metric-help">Baseline: [% IF promotions_portfolio %][% promotions_portfolio.portfolio_baseline_checkout_count %][% ELSE %]0[% END %]</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card blue"><div class="metric-label">Zero-response titles</div><div class="metric-value">[% IF promotions_portfolio %][% promotions_portfolio.zero_response_title_count %][% ELSE %]0[% END %]</div><div class="metric-help">No issue during measured campaign periods</div></div></div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading"><strong>Saved campaigns</strong></div>
                    <div class="panel-body">
                        [% IF campaigns && campaigns.size %]
                            <div class="table-responsive">
                                <table id="promotions-table" class="table table-striped table-hover promo-data-table" data-page-length="25" data-order-column="2" data-order-direction="desc">
                                    <thead>
                                        <tr>
                                            <th>Campaign</th>
                                            <th>Type / channel</th>
                                            <th>Period</th>
                                            <th>Location</th>
                                            <th>Promoted titles</th>
                                            <th>Titles Issued / Borrowed</th>
                                            <th>Checkouts</th>
                                            <th>Utilization</th>
                                            <th>Change vs baseline</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        [% FOREACH campaign IN campaigns %]
                                            <tr>
                                                <td>
                                                    <a href="?class=[% CLASS %]&method=[% METHOD %]&action=promotion_detail&campaign_id=[% campaign.campaign_id %]">
                                                        [% campaign.name | html %]
                                                    </a>
                                                </td>
                                                <td>[% campaign.campaign_type_label | html %]<br><small class="text-muted">[% campaign.channel_label | html %]</small></td>
                                                <td>[% campaign.start_date | html %][% IF campaign.end_date %] → [% campaign.end_date | html %][% ELSIF campaign.status == 'active' %] → today[% END %]</td>
                                                <td>[% IF campaign.location_labels %][% campaign.location_labels | html %][% ELSE %][% campaign.display_location | html %][% END %]</td>
                                                <td>[% IF campaign.analytics_available %][% campaign.promoted_title_count %][% ELSE %]—[% END %]<br><small class="text-muted">[% campaign.linked_item_count || 0 %] linked copies/items</small></td>
                                                <td>[% IF campaign.analytics_available %][% campaign.titles_used_display %][% ELSE %]—[% END %]</td>
                                                <td>[% IF campaign.analytics_available %][% campaign.campaign_checkout_display %][% ELSE %]—[% END %]</td>
                                                <td>[% IF campaign.title_utilization_display %][% campaign.title_utilization_display %]%[% ELSE %]—[% END %]</td>
                                                <td>[% IF campaign.uplift_display %][% campaign.uplift_display %]%[% ELSIF campaign.new_response %]New response[% ELSE %]—[% END %][% IF campaign.impact_provisional %] <small class="text-muted">(to date)</small>[% END %]</td>
                                                <td><span class="label label-default">[% campaign.status | html %]</span></td>
                                            </tr>
                                        [% END %]
                                    </tbody>
                                </table>
                            </div>
                            [% IF campaigns.size == 200 %]
                                <p class="text-muted">Showing up to 200 matching campaign records. Use Find campaigns to narrow the portfolio further.</p>
                            [% END %]
                        [% ELSE %]
                            <p class="text-muted">No promotions have been created yet.</p>
                        [% END %]
                    </div>
                </div>
            </main>
        </div>

        <div class="col-sm-2 col-sm-pull-10">
            <aside>
                <div class="sidebar_menu">
                    <ul>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]">Dashboard</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=new_promotion">New promotion</a></li>
                        <li class="active"><a href="?class=[% CLASS %]&method=[% METHOD %]&action=promotions">Promotions</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=analytics">Analytics</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=book_display_impact">Resource Impact</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=reports">Reports</a></li>
                        <li><a href="?class=[% CLASS %]&method=configure">Configuration</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</div>
[% MACRO jsinclude BLOCK %]
    [% INCLUDE "$PLUGIN_DIR/promoeng_ui_js.inc" %]
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
