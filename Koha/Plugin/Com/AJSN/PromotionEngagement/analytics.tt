[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]

[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: Promotion analytics</title>
[% INCLUDE 'doc-head-close.inc' %]
<style>
.promo-hero{background:linear-gradient(135deg,#17324d,#245b64);color:#fff;border-radius:8px;padding:24px 28px;margin-bottom:20px;box-shadow:0 4px 14px rgba(23,50,77,.18)}
.promo-hero h1{color:#fff;margin:0 0 7px;font-family:Georgia,serif}.promo-hero p{color:#dcebed;margin:0;font-size:1.08rem}
.selector-panel,.analytics-panel{border:1px solid #d8e1e5;border-radius:7px;box-shadow:0 2px 8px rgba(23,50,77,.06)}.selector-panel>.panel-heading,.analytics-panel>.panel-heading{background:#f1f5f6;color:#17324d;border-bottom:1px solid #d8e1e5}
.metric-card{background:#fff;border:1px solid #d8e1e5;border-top:4px solid #b28b32;border-radius:7px;padding:17px;min-height:112px;margin-bottom:16px;box-shadow:0 2px 8px rgba(23,50,77,.08)}
.metric-card.teal{border-top-color:#2d7372}.metric-card.blue{border-top-color:#3d6685}.metric-card strong{color:#526b78;text-transform:uppercase;letter-spacing:.04em;font-size:.8rem}.metric-number{color:#17324d;font-family:Georgia,serif;font-size:2.25rem;line-height:1.25}
.analytics-title{font-family:Georgia,serif;color:#17324d}.analytics-panel th{background:#f8fafb;color:#294d5b}
.impact-card{background:#f8fafb;border:1px solid #d8e1e5;border-left:6px solid #3d6685;border-radius:7px;padding:18px 20px;margin:16px 0 20px;box-shadow:0 2px 8px rgba(23,50,77,.06)}
.impact-card.impact-success{border-left-color:#2d7372;background:#f2f8f7}.impact-card.impact-warning{border-left-color:#b28b32;background:#fffaf0}.impact-card h3{font-family:Georgia,serif;color:#17324d;margin:0 0 6px}.impact-card p{margin:0 0 7px;font-size:1.02rem}.evidence-note{color:#607780;font-size:.9rem}
.response-badge{display:inline-block;border-radius:12px;padding:3px 9px;background:#edf2f4;color:#294d5b;font-size:.82rem;font-weight:700}.response-badge.positive{background:#e3f2ef;color:#1c605d}
.promo-kicker{text-transform:uppercase;letter-spacing:.1em;font-size:.76rem;font-weight:700;margin-bottom:5px}

/* Shared professional interaction treatment */
.btn-primary{background:#245b64!important;border-color:#1c4d55!important;color:#fff!important;font-weight:700;box-shadow:0 2px 5px rgba(23,50,77,.18)}
.btn-primary:hover,.btn-primary:focus{background:#17324d!important;border-color:#17324d!important;color:#fff!important}
.btn-default{background:#fff!important;border:1px solid #91a5ad!important;color:#17324d!important;font-weight:700;box-shadow:0 1px 3px rgba(23,50,77,.10)}
.btn-default:hover,.btn-default:focus{background:#edf4f4!important;border-color:#245b64!important;color:#102c43!important}
.btn-danger{color:#fff!important;font-weight:700}.btn i{margin-right:4px}
#toolbar,.btn-group,.export-bar{margin-bottom:18px}.table{background:#fff}.table>thead>tr>th{border-bottom:2px solid #9db2ba!important}
.table>tbody>tr:hover{background:#eef5f5!important}.table td,.table th{vertical-align:middle!important}
.sidebar_menu ul{border:1px solid #d8e1e5;border-radius:7px;overflow:hidden;background:#fff;box-shadow:0 2px 8px rgba(23,50,77,.06)}
.sidebar_menu ul li a{display:block;padding:11px 13px;color:#17324d!important;font-weight:700;border-left:4px solid transparent}
.sidebar_menu ul li a:hover,.sidebar_menu ul li a:focus{background:#edf4f4;text-decoration:none;border-left-color:#2d7372}
.sidebar_menu ul li.active a{background:#e5f0ef!important;color:#17324d!important;border-left-color:#2d7372!important}
.form-control:focus,input:focus,select:focus,textarea:focus{border-color:#2d7372!important;box-shadow:0 0 0 2px rgba(45,115,114,.15)!important}
.panel-heading strong{letter-spacing:.01em}.required{color:#8a2f39!important;font-weight:700}
</style>
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
        [% END %]
        [% WRAPPER breadcrumb_item %]
            <a href="?class=[% CLASS %]&method=[% METHOD %]">Promotion &amp; Engagement</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active=1 %]
            <span>Analytics</span>
        [% END %]
    [% END %]
[% END %]

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-10 col-sm-push-2">
            <main>
                <div class="promo-hero">
                    <h1>Promotion analytics</h1>
                    <p>Assess circulation response before, during and after each campaign using one transparent measurement framework.</p>
                </div>

                [% IF error_message %]
                    <div class="alert alert-danger">[% error_message | html %]</div>
                [% END %]

                <div class="panel panel-default selector-panel">
                    <div class="panel-heading"><strong>Select a campaign</strong></div>
                    <div class="panel-body">
                        <form method="get" action="/cgi-bin/koha/plugins/run.pl" class="form-inline">
                            <input type="hidden" name="class" value="[% CLASS | html %]">
                            <input type="hidden" name="method" value="[% METHOD | html %]">
                            <input type="hidden" name="action" value="analytics">
                            <label for="campaign_id">Campaign</label>
                            <select id="campaign_id" name="campaign_id" class="form-control">
                                <option value="">Choose a campaign</option>
                                [% FOREACH option IN campaigns %]
                                    <option value="[% option.campaign_id %]"[% IF selected_id == option.campaign_id %] selected="selected"[% END %]>
                                        [% option.name | html %] ([% option.start_date | html %])
                                    </option>
                                [% END %]
                            </select>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-bar-chart"></i> Calculate analytics
                            </button>
                            <a class="btn btn-default" href="?class=[% CLASS %]&method=[% METHOD %]&action=reports"><i class="fa fa-table"></i> Compare all campaigns</a>
                            <p class="help-block" style="margin-top:10px"><strong>Campaign Analytics</strong> explains one promotion in depth. Active campaigns are measured automatically through today. Use Comparative Reports for an institution-wide view.</p>
                        </form>
                    </div>
                </div>

                [% IF analytics %]
                    <h2 class="analytics-title">[% analytics.campaign.name | html %]</h2>
                    <p>
                        Measurement specification [% analytics.spec_version | html %].
                        <strong>[% analytics.promoted_title_count %] distinct title(s)</strong>
                        from <strong>[% analytics.eligible_item_count %] linked copy/item record(s)</strong>.
                    </p>
                    [% IF analytics.analysis_period.live_to_date %]
                        <div class="alert alert-info">
                            <strong>Active campaign — live analytics through [% analytics.analysis_period.as_of_date | html %].</strong>
                            The campaign does not need to be completed before results are calculated. Follow-up windows remain pending until their dates occur.
                        </div>
                    [% END %]
                    [% IF analytics.data_quality_warnings.size %]
                        [% FOREACH warning IN analytics.data_quality_warnings %]
                            <div class="alert alert-warning">[% warning | html %]</div>
                        [% END %]
                    [% END %]
                    <div class="impact-card impact-[% analytics.impact_evidence.tone | html %]">
                        <div class="promo-kicker" style="color:#526b78">Promotion impact finding</div>
                        <h3>[% analytics.impact_evidence.label | html %][% IF analytics.impact_evidence.provisional %] <small>Provisional</small>[% END %]</h3>
                        <p>[% analytics.impact_evidence.finding | html %]</p>
                        [% IF analytics.windows.during.state != 'pending' %]
                            <p>
                                <strong>[% analytics.campaign_checkout_display %]</strong> checkout(s) during promotion versus
                                <strong>[% analytics.baseline_checkout_count %]</strong> in the equal baseline period;
                                <strong>[% analytics.titles_used_display %] of [% analytics.promoted_title_count %]</strong> promoted title(s) were used
                                [% IF analytics.title_utilization_display %](<strong>[% analytics.title_utilization_display %]%</strong> utilization)[% END %].
                                [% IF analytics.uplift_display %]Circulation rate change: <strong>[% analytics.uplift_display %]%</strong>.[% ELSIF analytics.new_response %]<strong>New circulation response</strong> from a zero-checkout baseline.[% END %]
                            </p>
                        [% END %]
                        <div class="evidence-note">
                            <i class="fa fa-info-circle"></i>
                            Evidence is based on Koha checkout behaviour. Increased circulation supports improved discovery and engagement, but does not prove that a promotion caused every loan.
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-4"><div class="metric-card">
                            <strong>Promoted titles</strong><br>
                            <span class="metric-number">[% analytics.promoted_title_count %]</span>
                            <small class="text-muted">[% analytics.eligible_item_count %] linked copies/items</small>
                        </div></div>
                        <div class="col-md-2 col-sm-4"><div class="metric-card teal">
                            <strong>Titles used</strong><br>
                            <span class="metric-number">[% analytics.titles_used_display %]</span>
                            <small class="text-muted">Distinct promoted titles borrowed</small>
                        </div></div>
                        <div class="col-md-2 col-sm-4"><div class="metric-card blue">
                            <strong>Title utilization</strong><br>
                            [% IF analytics.title_utilization_display %]<span class="metric-number">[% analytics.title_utilization_display %]%</span>[% ELSE %]<span class="metric-number">—</span>[% END %]
                            <small class="text-muted">Breadth of promoted collection used</small>
                        </div></div>
                        <div class="col-md-2 col-sm-4"><div class="metric-card">
                            <strong>Campaign checkouts</strong><br>
                            <span class="metric-number">[% analytics.campaign_checkout_display %]</span>
                            <small class="text-muted">All checkout events in measured period</small>
                        </div></div>
                        <div class="col-md-2 col-sm-4"><div class="metric-card teal">
                            <strong>Baseline checkouts</strong><br>
                            <span class="metric-number">[% analytics.baseline_checkout_count %]</span>
                            <small class="text-muted">Equal period before promotion</small>
                        </div></div>
                        <div class="col-md-2 col-sm-4"><div class="metric-card blue">
                            <strong>Change vs baseline</strong><br>
                            [% IF analytics.uplift_display %]<span class="metric-number">[% analytics.uplift_display %]%</span>[% ELSIF analytics.new_response %]<span class="metric-number">New</span>[% ELSE %]<span class="metric-number">—</span>[% END %]
                            <small class="text-muted">Daily circulation-rate change</small>
                        </div></div>
                    </div>
                    <div class="panel panel-default analytics-panel">
                        <div class="panel-heading"><strong>Response signals</strong></div>
                        <div class="panel-body">
                            <strong>[% analytics.titles_increased_display %]</strong> title(s) increased versus baseline ·
                            <strong>[% analytics.zero_response_display %]</strong> zero-response title(s) ·
                            <strong>[% analytics.repeat_demand_display %]</strong> title(s) borrowed at least twice
                            [% IF analytics.days_to_first_available %] · first checkout after <strong>[% analytics.days_to_first_checkout %]</strong> day(s)[% END %]
                        </div>
                    </div>
                    <div class="panel panel-default analytics-panel">
                        <div class="panel-heading"><strong>Measurement windows</strong></div>
                        <div class="panel-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Window</th>
                                            <th>Dates</th>
                                            <th>Days</th>
                                            <th>Checkouts</th>
                                            <th>Unique items</th>
                                            <th>Conversion</th>
                                            <th>Daily rate</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        [% FOREACH row IN window_rows %]
                                            <tr>
                                                <td>
                                                    <strong>[% row.label | html %]</strong><br>
                                                    [% IF row.window.state == 'pending' %]<span class="label label-default">Pending</span>
                                                    [% ELSIF row.window.state == 'partial' %]<span class="label label-info">To date</span>
                                                    [% ELSE %]<span class="label label-success">Complete</span>[% END %]
                                                </td>
                                                <td>[% row.window.start | html %] to [% row.window.end | html %]</td>
                                                <td>[% row.window.days %]</td>
                                                [% IF row.window.state == 'pending' %]
                                                    <td class="text-muted">—</td>
                                                    <td class="text-muted">—</td>
                                                    <td class="text-muted">—</td>
                                                    <td class="text-muted">—</td>
                                                [% ELSE %]
                                                    <td>[% row.metrics.checkout_count %]</td>
                                                    <td>[% row.metrics.unique_items_checked_out %]</td>
                                                    <td>
                                                        [% IF row.metrics.eligible_item_count %]
                                                            [% row.metrics.conversion_rate %]%
                                                        [% ELSE %]
                                                            <span class="text-muted">—</span>
                                                        [% END %]
                                                    </td>
                                                    <td>[% row.metrics.daily_checkout_rate %]</td>
                                                [% END %]
                                            </tr>
                                        [% END %]
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="panel panel-default analytics-panel">
                        <div class="panel-heading"><strong>Promoted-title response</strong></div>
                        <div class="panel-body">
                            <p class="text-muted">Distinct bibliographic titles are shown here; multiple promoted copies of the same title are combined so title utilization is not overstated.</p>
                            [% IF analytics.title_response_rows.size %]
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead><tr><th>Promoted title</th><th>Copies / barcodes</th><th>Before promotion</th><th>During promotion</th><th>After promotion (60 days)</th><th>Response</th></tr></thead>
                                        <tbody>
                                            [% FOREACH item IN analytics.title_response_rows %]
                                                <tr>
                                                    <td><strong>[% item.title | html %]</strong>[% IF item.author %]<br><span class="text-muted">[% item.author | html %]</span>[% END %]</td>
                                                    <td><strong>[% item.promoted_copies %]</strong><br><small class="text-muted">[% item.barcodes.join(', ') | html %]</small></td>
                                                    <td>[% item.baseline_count %]</td>
                                                    <td>[% IF item.during_state == 'pending' %]<span class="text-muted">Pending</span>[% ELSE %][% item.during_count %][% END %]</td>
                                                    <td>[% IF item.after_60_state == 'pending' %]<span class="text-muted">Pending</span>[% ELSIF item.after_60_state == 'partial' %][% item.after_60_count %] <small class="text-muted">(to date)</small>[% ELSE %][% item.after_60_count %][% END %]</td>
                                                    <td>[% IF item.during_state == 'pending' %]<span class="response-badge">Pending</span>[% ELSE %]<span class="response-badge[% IF item.response_label == 'Increased' %] positive[% END %]">[% item.response_label | html %]</span>[% END %]</td>
                                                </tr>
                                            [% END %]
                                        </tbody>
                                    </table>
                                </div>
                            [% ELSE %]
                                <p class="text-muted">No linked Koha items are available for title-level measurement.</p>
                            [% END %]
                        </div>
                    </div>
                    <div class="alert alert-info">
                        <strong>Privacy:</strong>
                        This screen shows aggregate campaign results only. It does not expose patron names,
                        card numbers or individual borrowing histories.
                    </div>
                [% ELSIF campaigns.size == 0 %]
                    <div class="alert alert-info">Create a promotion before calculating analytics.</div>
                [% END %]
            </main>
        </div>

        <div class="col-sm-2 col-sm-pull-10">
            <aside>
                <div class="sidebar_menu">
                    <ul>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]">Dashboard</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=new_promotion">New promotion</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=promotions">Promotions</a></li>
                        <li class="active"><a href="?class=[% CLASS %]&method=[% METHOD %]&action=analytics">Analytics</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=book_display_impact">Resource Impact</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=reports">Reports</a></li>
                        <li><a href="?class=[% CLASS %]&method=configure">Configuration</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</div>
[% INCLUDE 'intranet-bottom.inc' %]

