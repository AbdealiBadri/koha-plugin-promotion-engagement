[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% USE KohaDates %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]

[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: Promotion details</title>
[% INCLUDE 'doc-head-close.inc' %]
<style>
main>h1{font-family:Georgia,serif;color:#17324d}main>.lead{color:#58717c;max-width:920px}
.panel-default{border-color:#d8e1e5;border-radius:6px;box-shadow:0 2px 8px rgba(23,50,77,.05)}
.panel-default>.panel-heading{background:#f1f5f6;color:#17324d;border-color:#d8e1e5;padding:12px 15px}
.table>thead>tr>th{background:#f8fafb;color:#294d5b}.btn-primary{background:#245b64;border-color:#1c4d55}.btn-primary:hover{background:#17324d;border-color:#17324d}

/* Shared professional interaction treatment */
.btn-primary{background:#245b64!important;border-color:#1c4d55!important;color:#fff!important;font-weight:700;box-shadow:0 2px 5px rgba(23,50,77,.18)}
.btn-primary:hover,.btn-primary:focus{background:#17324d!important;border-color:#17324d!important;color:#fff!important}
.btn-default{background:#fff!important;border:1px solid #91a5ad!important;color:#17324d!important;font-weight:700;box-shadow:0 1px 3px rgba(23,50,77,.10)}
.btn-default:hover,.btn-default:focus{background:#edf4f4!important;border-color:#245b64!important;color:#102c43!important}
.btn-danger{color:#fff!important;font-weight:700}.btn i{margin-right:4px}
#toolbar,.btn-group,.export-bar{margin-bottom:18px}.table{background:#fff}.table>thead>tr>th{border-bottom:2px solid #9db2ba!important}
.table>tbody>tr:hover{background:#eef5f5!important}.table td,.table th{vertical-align:middle!important}
.sidebar_menu ul{border:1px solid #d8e1e5;border-radius:7px;overflow:hidden;background:#fff;box-shadow:0 2px 8px rgba(23,50,77,.06)}
.sidebar_menu ul li a{display:block;padding:11px 13px;color:#17324d!important;font-weight:700;border-left:4px solid transparent}
.sidebar_menu ul li a:hover,.sidebar_menu ul li a:focus{background:#edf4f4;text-decoration:none;border-left-color:#2d7372}
.sidebar_menu ul li.active a{background:#e5f0ef!important;color:#17324d!important;border-left-color:#2d7372!important}
.form-control:focus,input:focus,select:focus,textarea:focus{border-color:#2d7372!important;box-shadow:0 0 0 2px rgba(45,115,114,.15)!important}
.panel-heading strong{letter-spacing:.01em}.required{color:#8a2f39!important;font-weight:700}
</style>
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
        [% END %]
        [% WRAPPER breadcrumb_item %]
            <a href="?class=[% CLASS %]&method=[% METHOD %]">Promotion &amp; Engagement</a>
        [% END %]
        [% WRAPPER breadcrumb_item %]
            <a href="?class=[% CLASS %]&method=[% METHOD %]&action=promotions">Promotions</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active=1 %]
            <span>[% campaign.name | html %]</span>
        [% END %]
    [% END %]
[% END %]

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-10 col-sm-push-2">
            <main>
                <div id="toolbar" class="btn-toolbar">
                    <a class="btn btn-default" href="?class=[% CLASS %]&method=[% METHOD %]&action=promotions">
                        <i class="fa fa-arrow-left"></i> Back to promotions
                    </a>
                    <a class="btn btn-primary" href="?class=[% CLASS %]&method=[% METHOD %]&action=edit_promotion&campaign_id=[% campaign.campaign_id %]">
                        <i class="fa fa-pencil"></i> Edit promotion
                    </a>
                    <a class="btn btn-default" href="?class=[% CLASS %]&method=[% METHOD %]&action=new_promotion">
                        <i class="fa fa-plus"></i> New promotion
                    </a>
                    <form method="post" action="/cgi-bin/koha/plugins/run.pl" style="display:inline" onsubmit="return confirm('Archive this campaign? It will be hidden from active campaign lists but its historical data and audit trail will be preserved.');">
                        <input type="hidden" name="class" value="[% CLASS | html %]">
                        <input type="hidden" name="method" value="[% METHOD | html %]">
                        <input type="hidden" name="action" value="archive_promotion">
                        <input type="hidden" name="op" value="cud-archive_promotion">
                        <input type="hidden" name="campaign_id" value="[% campaign.campaign_id %]">
                        <input type="hidden" name="archive_confirm" value="1">
                        <input type="hidden" name="csrf_token" value="[% Koha.GenerateCSRF | html %]">
                        <button type="submit" class="btn btn-danger">
                            <i class="fa fa-archive"></i> Archive
                        </button>
                    </form>
                </div>

                <h1>[% campaign.name | html %]</h1>
                <p class="lead">Campaign record with live Koha-linked item data and auditable management actions.</p>

                [% IF success_message %]
                    <div class="alert alert-success">[% success_message | html %]</div>
                [% END %]

                <div class="row">
                    <div class="col-md-7">
                        <div class="panel panel-default">
                            <div class="panel-heading"><strong>Campaign details</strong></div>
                            <div class="panel-body">
                                <table class="table table-condensed">
                                    <tbody>
                                        <tr><th>Campaign ID</th><td>[% campaign.campaign_id %]</td></tr>
                                        <tr><th>UUID</th><td><code>[% campaign.campaign_uuid | html %]</code></td></tr>
                                        <tr><th>Type</th><td>[% campaign.campaign_type_label | html %]</td></tr>
                                        <tr><th>Channel</th><td>[% campaign.channel_label | html %]</td></tr>
                                        <tr><th>Status</th><td><strong>[% campaign.status | html %]</strong></td></tr>
                                        <tr><th>Start</th><td>[% campaign.start_date | html %]</td></tr>
                                        <tr><th>End</th><td>[% campaign.end_date | html %]</td></tr>
                                        <tr>
                                            <th>Koha library</th>
                                            <td>
                                                [% IF campaign.branchcode %]
                                                    [% campaign.branchname | html %] ([% campaign.branchcode | html %])
                                                [% ELSE %]
                                                    All / institution-wide
                                                [% END %]
                                            </td>
                                        </tr>
                                        <tr><th>Target audience</th><td>[% campaign.target_audience | html %]</td></tr>
                                        <tr><th>Language(s)</th><td>[% campaign.language_code | html %]</td></tr>
                                        <tr>
                                            <th>Location(s)</th>
                                            <td>
                                                [% IF campaign_locations.size %]
                                                    [% FOREACH location IN campaign_locations %][% IF !loop.first %] · [% END %][% location.label | html %][% END %]
                                                [% ELSE %]
                                                    [% campaign.display_location | html %]
                                                [% END %]
                                            </td>
                                        </tr>
                                        <tr><th>Created by</th><td>[% campaign.created_by | html %]</td></tr>
                                        <tr><th>Created</th><td>[% campaign.created_at | html %]</td></tr>
                                        <tr><th>Updated</th><td>[% campaign.updated_at | html %]</td></tr>
                                    </tbody>
                                </table>
                                [% IF campaign.notes %]
                                    <h3>Notes</h3>
                                    <p>[% campaign.notes | html %]</p>
                                [% END %]
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="panel panel-default">
                            <div class="panel-heading"><strong>Current scope</strong></div>
                            <div class="panel-body">
                                <p>Campaign metadata can be edited without changing Koha catalogue records.</p>
                                <ul>
                                    <li>Linked barcodes are validated against live Koha items before updates are saved.</li>
                                    <li>Removing a linked item from a campaign uses plugin soft-delete semantics.</li>
                                    <li>Editing, status changes and archiving are recorded in the campaign audit history.</li>
                                    <li>Linked title/author data below is always read live from Koha.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading"><strong>Linked Koha items</strong> ([% linked_items.size %])</div>
                    <div class="panel-body">
                        [% IF linked_items && linked_items.size %]
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Barcode</th>
                                            <th>Title</th>
                                            <th>Author</th>
                                            <th>Itemnumber</th>
                                            <th>Biblionumber</th>
                                            <th>Linked</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        [% FOREACH item IN linked_items %]
                                            <tr>
                                                <td><code>[% item.barcode | html %]</code></td>
                                                <td>[% item.title | html %]</td>
                                                <td>[% item.author | html %]</td>
                                                <td>[% item.itemnumber %]</td>
                                                <td>[% item.biblionumber %]</td>
                                                <td>[% item.added_at | html %]</td>
                                            </tr>
                                        [% END %]
                                    </tbody>
                                </table>
                            </div>
                        [% ELSE %]
                            <p class="text-muted">No Koha items are linked to this campaign.</p>
                        [% END %]
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading"><strong>Audit history</strong></div>
                    <div class="panel-body">
                        [% IF audit_rows && audit_rows.size %]
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>When</th>
                                            <th>Action</th>
                                            <th>Actor</th>
                                            <th>Entity</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        [% FOREACH audit IN audit_rows %]
                                            <tr>
                                                <td>[% audit.created_at | html %]</td>
                                                <td>[% audit.action_type | html %]</td>
                                                <td>[% audit.actor_borrowernumber | html %]</td>
                                                <td>[% audit.entity_type | html %] [% audit.entity_id | html %]</td>
                                            </tr>
                                        [% END %]
                                    </tbody>
                                </table>
                            </div>
                        [% ELSE %]
                            <p class="text-muted">No audit entries are recorded for this campaign.</p>
                        [% END %]
                    </div>
                </div>
            </main>
        </div>

        <div class="col-sm-2 col-sm-pull-10">
            <aside>
                <div class="sidebar_menu">
                    <ul>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]">Dashboard</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=new_promotion">New promotion</a></li>
                        <li class="active"><a href="?class=[% CLASS %]&method=[% METHOD %]&action=promotions">Promotions</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=analytics">Analytics</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=book_display_impact">Book Display Impact</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=reports">Reports</a></li>
                        <li><a href="?class=[% CLASS %]&method=configure">Configuration</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</div>
[% INCLUDE 'intranet-bottom.inc' %]
