[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% USE KohaDates %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]

[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: New promotion</title>
[% INCLUDE 'doc-head-close.inc' %]
<style>
main>h1{font-family:Georgia,serif;color:#17324d}main>.lead{color:#58717c;max-width:920px}
.panel-default{border-color:#d8e1e5;border-radius:6px;box-shadow:0 2px 8px rgba(23,50,77,.05)}
.panel-default>.panel-heading{background:#f1f5f6;color:#17324d;border-color:#d8e1e5;padding:12px 15px}
.table>thead>tr>th{background:#f8fafb;color:#294d5b}.btn-primary{background:#245b64;border-color:#1c4d55}.btn-primary:hover{background:#17324d;border-color:#17324d}
</style>
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
        [% END %]
        [% WRAPPER breadcrumb_item %]
            <a href="?class=[% CLASS %]&method=[% METHOD %]">Promotion &amp; Engagement</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active=1 %]
            <span>New promotion</span>
        [% END %]
    [% END %]
[% END %]

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-10 col-sm-push-2">
            <main>
                <h1>New promotion</h1>
                <p class="lead">Create a campaign and link it to Koha items without duplicating catalogue data.</p>

                [% IF errors && errors.size %]
                    <div class="alert alert-danger">
                        <h2>Campaign not saved</h2>
                        <ul>
                            [% FOREACH error IN errors %]
                                <li>[% error | html %]</li>
                            [% END %]
                        </ul>
                    </div>
                [% END %]

                [% IF warnings && warnings.size %]
                    <div class="alert alert-warning">
                        <ul>
                            [% FOREACH warning IN warnings %]
                                <li>[% warning | html %]</li>
                            [% END %]
                        </ul>
                    </div>
                [% END %]

                [% IF invalid_barcodes && invalid_barcodes.size %]
                    <div class="alert alert-danger">
                        <strong>Invalid Koha barcodes:</strong>
                        <ul>
                            [% FOREACH barcode IN invalid_barcodes %]
                                <li><code>[% barcode | html %]</code></li>
                            [% END %]
                        </ul>
                    </div>
                [% END %]

                [% IF duplicate_barcodes && duplicate_barcodes.size %]
                    <div class="alert alert-warning">
                        <strong>Duplicate entries ignored:</strong>
                        <ul>
                            [% FOREACH barcode IN duplicate_barcodes %]
                                <li><code>[% barcode | html %]</code></li>
                            [% END %]
                        </ul>
                    </div>
                [% END %]

                [% IF valid_item_count %]
                    <div class="alert alert-info">
                        [% valid_item_count %] valid Koha item[% IF valid_item_count != 1 %]s[% END %] found in the submitted barcode list.
                    </div>
                [% END %]

                <form method="post" action="/cgi-bin/koha/plugins/run.pl">
                    <input type="hidden" name="class" value="[% CLASS | html %]">
                    <input type="hidden" name="method" value="[% METHOD | html %]">
                    <input type="hidden" name="action" value="new_promotion">
                    <input type="hidden" name="op" value="cud-create_promotion">
                    <input type="hidden" name="csrf_token" value="[% Koha.GenerateCSRF | html %]">

                    <fieldset class="rows">
                        <legend>Campaign details</legend>
                        <ol>
                            <li>
                                <label for="campaign_type" class="required">Promotion type:</label>
                                <select id="campaign_type" name="campaign_type" required>
                                    <option value="">Select a type</option>
                                    [% FOREACH type IN campaign_types %]
                                        <option value="[% type.value_code | html %]" [% IF form.campaign_type == type.value_code %]selected[% END %]>[% type.label | html %]</option>
                                    [% END %]
                                </select>
                                <span class="required">Required</span>
                                <div class="hint">Values come from Promotion &amp; Engagement configuration.</div>
                            </li>
                            <li>
                                <label for="channel" class="required">Channel:</label>
                                <select id="channel" name="channel" required>
                                    <option value="">Select a channel</option>
                                    [% FOREACH channel_item IN channels %]
                                        <option value="[% channel_item.value_code | html %]" [% IF form.channel == channel_item.value_code %]selected[% END %]>[% channel_item.label | html %]</option>
                                    [% END %]
                                </select>
                                <span class="required">Required</span>
                                <div class="hint">Values come from Promotion &amp; Engagement configuration.</div>
                            </li>
                            <li>
                                <label for="name" class="required">Campaign name:</label>
                                <input id="name" name="name" type="text" size="60" maxlength="255" required value="[% form.name | html %]" placeholder="e.g. Islamic History Display – August 2026">
                                <span class="required">Required</span>
                            </li>
                            <li>
                                <label for="start_date" class="required">Start date:</label>
                                <input id="start_date" name="start_date" type="date" required value="[% form.start_date | html %]">
                                <span class="required">Required</span>
                            </li>
                            <li>
                                <label for="end_date">End date:</label>
                                <input id="end_date" name="end_date" type="date" value="[% form.end_date | html %]">
                            </li>
                            <li>
                                <label for="status">Status:</label>
                                <select id="status" name="status">
                                    <option value="draft" [% IF !form.status || form.status == 'draft' %]selected[% END %]>Draft</option>
                                    <option value="active" [% IF form.status == 'active' %]selected[% END %]>Active</option>
                                    <option value="completed" [% IF form.status == 'completed' %]selected[% END %]>Completed</option>
                                </select>
                            </li>
                            <li>
                                <label for="branchcode">Koha library:</label>
                                <select id="branchcode" name="branchcode">
                                    <option value="">All / institution-wide</option>
                                    [% FOREACH library IN libraries %]
                                        <option value="[% library.branchcode | html %]" [% IF form.branchcode == library.branchcode %]selected[% END %]>[% library.branchname | html %] ([% library.branchcode | html %])</option>
                                    [% END %]
                                </select>
                            </li>
                            <li>
                                <label for="target_audience">Target audience:</label>
                                <input id="target_audience" name="target_audience" type="text" size="60" maxlength="255" value="[% form.target_audience | html %]" placeholder="e.g. Darajah 5–7, faculty, all users">
                            </li>
                            <li>
                                <label for="language_code">Language(s):</label>
                                <input id="language_code" name="language_code" type="text" size="40" maxlength="30" value="[% form.language_code | html %]" placeholder="e.g. English, Arabic">
                            </li>
                            <li>
                                <label for="location_value_id">Location(s):</label>
                                [% IF locations.size %]
                                    <select id="location_value_id" name="location_value_id" multiple size="6">
                                        [% FOREACH location IN locations %]
                                            <option value="[% location.vocab_value_id %]" [% IF location.selected %]selected[% END %]>[% location.label | html %][% IF !location.is_active %] (disabled)[% END %]</option>
                                        [% END %]
                                    </select>
                                    <div class="hint">Choose one or more reusable promotion locations. Hold Ctrl/Command to select multiple values.</div>
                                [% ELSE %]
                                    <div class="alert alert-warning">
                                        No reusable locations are configured yet. Add them from the plugin Configuration screen.
                                    </div>
                                [% END %]
                                [% IF form.display_location && !locations.size %]
                                    <div class="hint">Legacy location: [% form.display_location | html %]</div>
                                [% END %]
                            </li>
                            <li>
                                <label for="notes">Notes:</label>
                                <textarea id="notes" name="notes" rows="4" cols="70">[% form.notes | html %]</textarea>
                            </li>
                        </ol>
                    </fieldset>

                    <fieldset class="rows">
                        <legend>Linked Koha items</legend>
                        <ol>
                            <li>
                                <label for="barcodes">Barcodes:</label>
                                <textarea id="barcodes" name="barcodes" rows="10" cols="45" placeholder="One barcode per line; comma and semicolon separated values are also accepted">[% form.barcodes_text | html %]</textarea>
                                <div class="hint">Optional. Every supplied barcode is validated against Koha before anything is saved. Invalid barcodes block the save; duplicate entries are ignored and reported.</div>
                            </li>
                        </ol>
                    </fieldset>

                    <fieldset class="action">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save"></i> Validate and save campaign
                        </button>
                        <a class="btn btn-default" href="?class=[% CLASS %]&method=[% METHOD %]">Cancel</a>
                    </fieldset>
                </form>
            </main>
        </div>

        <div class="col-sm-2 col-sm-pull-10">
            <aside>
                <div class="sidebar_menu">
                    <ul>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]">Dashboard</a></li>
                        <li class="active"><a href="?class=[% CLASS %]&method=[% METHOD %]&action=new_promotion">New promotion</a></li>
                                            <li><a href="?class=[% CLASS %]&method=configure">Configuration</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</div>
[% INCLUDE 'intranet-bottom.inc' %]
