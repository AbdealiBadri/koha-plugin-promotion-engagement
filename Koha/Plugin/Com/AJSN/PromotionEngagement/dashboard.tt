[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% USE KohaDates %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]

[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: Promotion &amp; Engagement</title>
[% INCLUDE 'doc-head-close.inc' %]
<style>
.promo-hero{background:linear-gradient(135deg,#17324d 0%,#245b64 72%,#2d7372 100%);color:#fff;border-radius:8px;padding:26px 30px;margin:0 0 20px;box-shadow:0 5px 16px rgba(23,50,77,.2)}
.promo-hero h1{color:#fff;margin:0 0 8px;font-family:Georgia,serif;font-size:2.2rem}.promo-hero p{color:#dcebed;font-size:1.1rem;margin:0}
.promo-kicker{text-transform:uppercase;letter-spacing:.12em;color:#e2c675;font-size:.78rem;font-weight:700;margin-bottom:7px}
.metric-card{background:#fff;border:1px solid #d9e2e6;border-radius:7px;padding:17px 18px;min-height:116px;margin-bottom:18px;box-shadow:0 2px 9px rgba(23,50,77,.08);position:relative;overflow:hidden}
.metric-card:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:#b28b32}.metric-card.teal:before{background:#2d7372}.metric-card.blue:before{background:#3d6685}
.metric-label{color:#5a707a;text-transform:uppercase;letter-spacing:.05em;font-size:.78rem;font-weight:700}.metric-value{font-family:Georgia,serif;color:#17324d;font-size:2.25rem;line-height:1.15;margin:7px 0 2px}.metric-help{color:#73868e;font-size:.86rem}
.academic-panel{border:1px solid #d9e2e6;border-radius:7px;box-shadow:0 2px 9px rgba(23,50,77,.06)}.academic-panel>.panel-heading{background:#f1f5f6;color:#17324d;padding:13px 16px;border-bottom:1px solid #d9e2e6}
.academic-panel th{background:#f8fafb;color:#294d5b}.section-title{color:#17324d;font-family:Georgia,serif;margin:8px 0 14px}
.evidence-step{background:#fff;border:1px solid #d9e2e6;border-radius:7px;padding:16px;min-height:145px;margin-bottom:18px;position:relative;box-shadow:0 2px 8px rgba(23,50,77,.06)}.evidence-step .step-number{display:inline-block;background:#17324d;color:#fff;width:27px;height:27px;border-radius:50%;line-height:27px;text-align:center;font-weight:700;margin-bottom:9px}.evidence-step h3{font-family:Georgia,serif;color:#17324d;font-size:1.2rem;margin:0 0 6px}.evidence-step p{color:#607780;margin:0}.evidence-step.highlight{border-top:4px solid #b28b32;background:#fffdf7}

/* Shared professional interaction treatment */
.btn-primary{background:#245b64!important;border-color:#1c4d55!important;color:#fff!important;font-weight:700;box-shadow:0 2px 5px rgba(23,50,77,.18)}
.btn-primary:hover,.btn-primary:focus{background:#17324d!important;border-color:#17324d!important;color:#fff!important}
.btn-default{background:#fff!important;border:1px solid #91a5ad!important;color:#17324d!important;font-weight:700;box-shadow:0 1px 3px rgba(23,50,77,.10)}
.btn-default:hover,.btn-default:focus{background:#edf4f4!important;border-color:#245b64!important;color:#102c43!important}
.btn-danger{color:#fff!important;font-weight:700}.btn i{margin-right:4px}
#toolbar,.btn-group,.export-bar{margin-bottom:18px}.table{background:#fff}.table>thead>tr>th{border-bottom:2px solid #9db2ba!important}
.table>tbody>tr:hover{background:#eef5f5!important}.table td,.table th{vertical-align:middle!important}
.sidebar_menu ul{border:1px solid #d8e1e5;border-radius:7px;overflow:hidden;background:#fff;box-shadow:0 2px 8px rgba(23,50,77,.06)}
.sidebar_menu ul li a{display:block;padding:11px 13px;color:#17324d!important;font-weight:700;border-left:4px solid transparent}
.sidebar_menu ul li a:hover,.sidebar_menu ul li a:focus{background:#edf4f4;text-decoration:none;border-left-color:#2d7372}
.sidebar_menu ul li.active a{background:#e5f0ef!important;color:#17324d!important;border-left-color:#2d7372!important}
.form-control:focus,input:focus,select:focus,textarea:focus{border-color:#2d7372!important;box-shadow:0 0 0 2px rgba(45,115,114,.15)!important}
.panel-heading strong{letter-spacing:.01em}.required{color:#8a2f39!important;font-weight:700}
</style>
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active=1 %]
            <span>Promotion &amp; Engagement</span>
        [% END %]
    [% END %]
[% END %]

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-10 col-sm-push-2">
            <main>
                <div id="toolbar" class="btn-toolbar">
                    <a class="btn btn-primary" href="?class=[% CLASS %]&method=[% METHOD %]&action=new_promotion">
                        <i class="fa fa-plus"></i> New promotion
                    </a>
                    <a class="btn btn-default" href="?class=[% CLASS %]&method=[% METHOD %]&action=promotions">
                        <i class="fa fa-list"></i> View promotions
                    </a>
                </div>

                <div class="promo-hero">
                    <div class="promo-kicker">Evidence-led library engagement</div>
                    <h1>Promotion &amp; Engagement</h1>
                    <p>Plan campaigns, connect promoted resources to Koha, and evaluate measurable circulation impact.</p>
                </div>

                [% IF success_message %]
                    <div class="alert alert-success">[% success_message | html %]</div>
                [% END %]
                [% IF warning_message %]
                    <div class="alert alert-warning">[% warning_message | html %]</div>
                [% END %]

                <h2 class="section-title">Promotion performance at a glance</h2>
                <div class="row">
                    <div class="col-md-2 col-sm-4"><div class="metric-card"><div class="metric-label">Promoted titles</div><div class="metric-value">[% IF portfolio %][% portfolio.promoted_title_count %][% ELSE %]0[% END %]</div><div class="metric-help">[% IF portfolio %][% portfolio.promoted_item_count %][% ELSE %]0[% END %] linked copies/items</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card teal"><div class="metric-label">Titles used</div><div class="metric-value">[% IF portfolio %][% portfolio.titles_used_count %][% ELSE %]0[% END %]</div><div class="metric-help">Borrowed during campaign periods</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card blue"><div class="metric-label">Title utilization</div><div class="metric-value">[% IF portfolio_utilization_display %][% portfolio_utilization_display %]%[% ELSE %]—[% END %]</div><div class="metric-help">Share of promoted titles borrowed</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card"><div class="metric-label">Campaign checkouts</div><div class="metric-value">[% IF portfolio %][% portfolio.portfolio_campaign_checkout_count %][% ELSE %]0[% END %]</div><div class="metric-help">Baseline: [% IF portfolio %][% portfolio.portfolio_baseline_checkout_count %][% ELSE %]0[% END %] de-duplicated</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card teal"><div class="metric-label">Zero-response titles</div><div class="metric-value">[% IF portfolio %][% portfolio.zero_response_title_count %][% ELSE %]0[% END %]</div><div class="metric-help">No checkout during campaign periods</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card blue"><div class="metric-label">Active campaigns</div><div class="metric-value">[% active_count %]</div><div class="metric-help">Live activities measured to date</div></div></div>
                </div>
                <div class="panel panel-default academic-panel" style="margin-bottom:18px">
                    <div class="panel-body">
                        <strong>Portfolio administration:</strong>
                        [% campaign_count %] campaign(s) ·
                        [% completed_count %] completed ·
                        [% item_count %] linked item record(s) ·
                        [% location_count %] configured location(s)
                    </div>
                </div>
                <div class="btn-group" style="margin-bottom:20px">
                    <a class="btn btn-primary" href="?class=[% CLASS %]&method=[% METHOD %]&action=analytics"><i class="fa fa-bar-chart"></i> Campaign analytics</a>
                    <a class="btn btn-default" href="?class=[% CLASS %]&method=[% METHOD %]&action=book_display_impact"><i class="fa fa-book"></i> Resource Impact</a>
                    <a class="btn btn-default" href="?class=[% CLASS %]&method=[% METHOD %]&action=reports"><i class="fa fa-file-text-o"></i> Comparative reports</a>
                </div>

                <h2 class="section-title">How promotion becomes evidence</h2>
                <div class="row">
                    <div class="col-md-3"><div class="evidence-step"><span class="step-number">1</span><h3>Record the promotion</h3><p>Capture dates, channel, audience, locations where relevant, and every promoted Koha barcode.</p></div></div>
                    <div class="col-md-3"><div class="evidence-step"><span class="step-number">2</span><h3>Establish the baseline</h3><p>Measure the same resources in an equal period immediately before promotion.</p></div></div>
                    <div class="col-md-3"><div class="evidence-step"><span class="step-number">3</span><h3>Observe response</h3><p>Track checkouts while the promotion is active and through the 60-day follow-up.</p></div></div>
                    <div class="col-md-3"><div class="evidence-step highlight"><span class="step-number">4</span><h3>Present the finding</h3><p>Show utilization, baseline change and title-level response as evidence of engagement.</p></div></div>
                </div>

                <div class="panel panel-default academic-panel">
                    <div class="panel-heading"><strong><i class="fa fa-map-marker"></i> Display-location intelligence</strong></div>
                    <div class="panel-body">
                        [% IF leading_location %]
                            <div class="row">
                                <div class="col-md-8">
                                    <div class="promo-kicker" style="color:#7b6226">Leading single-location evidence</div>
                                    <h3 style="color:#17324d;margin:4px 0 8px">[% leading_location.label | html %]</h3>
                                    <p><strong>[% leading_location.exclusive_checkout_count %]</strong> measured checkout(s) across <strong>[% leading_location.exclusive_campaign_count %]</strong> campaign(s) assigned only to this location.</p>
                                </div>
                                <div class="col-md-4 text-right">
                                    <a class="btn btn-primary" href="?class=[% CLASS %]&method=[% METHOD %]&action=reports"><i class="fa fa-map"></i> Review location evidence</a>
                                </div>
                            </div>
                        [% ELSE %]
                            <p><strong>No leading location can be named yet.</strong> Add checkout evidence from campaigns assigned to one display location. Multi-location campaigns are excluded from this conclusion because Koha cannot identify at which physical point the reader discovered the book.</p>
                        [% END %]
                    </div>
                </div>

                <div class="panel panel-default academic-panel">
                    <div class="panel-heading"><strong>Recent promotions</strong></div>
                    <div class="panel-body">
                        [% IF recent_campaigns && recent_campaigns.size %]
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Campaign</th>
                                            <th>Type / channel</th>
                                            <th>Period</th>
                                            <th>Promoted</th>
                                            <th>Used</th>
                                            <th>Checkouts</th>
                                            <th>Utilization</th>
                                            <th>Change vs baseline</th>
                                            <th>Status</th>
                                            <th>Evidence</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        [% FOREACH campaign IN recent_campaigns %]
                                            <tr>
                                                <td>
                                                    <a href="?class=[% CLASS %]&method=[% METHOD %]&action=promotion_detail&campaign_id=[% campaign.campaign_id %]">
                                                        [% campaign.name | html %]
                                                    </a>
                                                </td>
                                                <td>[% campaign.campaign_type_label | html %]<br><small class="text-muted">[% campaign.channel_label | html %]</small></td>
                                                <td>[% campaign.start_date | html %][% IF campaign.end_date %] → [% campaign.end_date | html %][% ELSIF campaign.status == 'active' %] → today[% END %]</td>
                                                <td>[% IF campaign.analytics_available %][% campaign.promoted_title_count %][% ELSE %]—[% END %]</td>
                                                <td>[% IF campaign.analytics_available %][% campaign.titles_used_display %][% ELSE %]—[% END %]</td>
                                                <td>[% IF campaign.analytics_available %][% campaign.campaign_checkout_display %][% ELSE %]—[% END %]</td>
                                                <td>[% IF campaign.title_utilization_display %][% campaign.title_utilization_display %]%[% ELSE %]—[% END %]</td>
                                                <td>[% IF campaign.uplift_display %][% campaign.uplift_display %]%[% ELSIF campaign.new_response %]New response[% ELSE %]—[% END %][% IF campaign.impact_provisional %] <small class="text-muted">(to date)</small>[% END %]</td>
                                                <td><span class="label label-default">[% campaign.status | html %]</span></td>
                                                <td><a class="btn btn-xs btn-default" href="?class=[% CLASS %]&method=[% METHOD %]&action=analytics&campaign_id=[% campaign.campaign_id %]"><i class="fa fa-line-chart"></i> View impact</a></td>
                                            </tr>
                                        [% END %]
                                    </tbody>
                                </table>
                            </div>
                        [% ELSE %]
                            <p class="text-muted">No promotions have been created yet.</p>
                        [% END %]
                    </div>
                </div>

                <div class="panel panel-default academic-panel">
                    <div class="panel-heading"><strong>Measurement framework</strong></div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-md-4"><strong>Koha authoritative data</strong><p class="text-muted">Catalogue, circulation, patron and branch information remain in Koha.</p></div>
                            <div class="col-md-4"><strong>Comparable time windows</strong><p class="text-muted">Equal baseline and campaign periods plus 7, 14, 30 and 60-day follow-up.</p></div>
                            <div class="col-md-4"><strong>Privacy by design</strong><p class="text-muted">General analytics remain aggregate-only and small borrower cohorts are suppressed.</p></div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
        <div class="col-sm-2 col-sm-pull-10">
            <aside>
                <div class="sidebar_menu">
                    <ul>
                        <li class="active"><a href="?class=[% CLASS %]&method=[% METHOD %]">Dashboard</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=new_promotion">New promotion</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=promotions">Promotions</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=analytics">Analytics</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=book_display_impact">Resource Impact</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=reports">Reports</a></li>
                        <li><a href="?class=[% CLASS %]&method=configure">Configuration</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</div>
[% INCLUDE 'intranet-bottom.inc' %]
