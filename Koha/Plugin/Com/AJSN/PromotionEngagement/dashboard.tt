[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% USE KohaDates %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]

[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: Promotion &amp; Engagement</title>
[% INCLUDE 'doc-head-close.inc' %]
<style>
.promo-hero{background:linear-gradient(135deg,#17324d 0%,#245b64 72%,#2d7372 100%);color:#fff;border-radius:8px;padding:26px 30px;margin:0 0 20px;box-shadow:0 5px 16px rgba(23,50,77,.2)}
.promo-hero h1{color:#fff;margin:0 0 8px;font-family:Georgia,serif;font-size:2.2rem}.promo-hero p{color:#dcebed;font-size:1.1rem;margin:0}
.promo-kicker{text-transform:uppercase;letter-spacing:.12em;color:#e2c675;font-size:.78rem;font-weight:700;margin-bottom:7px}
.metric-card{background:#fff;border:1px solid #d9e2e6;border-radius:7px;padding:17px 18px;min-height:116px;margin-bottom:18px;box-shadow:0 2px 9px rgba(23,50,77,.08);position:relative;overflow:hidden}
.metric-card:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:#b28b32}.metric-card.teal:before{background:#2d7372}.metric-card.blue:before{background:#3d6685}
.metric-label{color:#5a707a;text-transform:uppercase;letter-spacing:.05em;font-size:.78rem;font-weight:700}.metric-value{font-family:Georgia,serif;color:#17324d;font-size:2.25rem;line-height:1.15;margin:7px 0 2px}.metric-help{color:#73868e;font-size:.86rem}
.academic-panel{border:1px solid #d9e2e6;border-radius:7px;box-shadow:0 2px 9px rgba(23,50,77,.06)}.academic-panel>.panel-heading{background:#f1f5f6;color:#17324d;padding:13px 16px;border-bottom:1px solid #d9e2e6}
.academic-panel th{background:#f8fafb;color:#294d5b}.section-title{color:#17324d;font-family:Georgia,serif;margin:8px 0 14px}
.evidence-step{background:#fff;border:1px solid #d9e2e6;border-radius:7px;padding:16px;min-height:145px;margin-bottom:18px;position:relative;box-shadow:0 2px 8px rgba(23,50,77,.06)}.evidence-step .step-number{display:inline-block;background:#17324d;color:#fff;width:27px;height:27px;border-radius:50%;line-height:27px;text-align:center;font-weight:700;margin-bottom:9px}.evidence-step h3{font-family:Georgia,serif;color:#17324d;font-size:1.2rem;margin:0 0 6px}.evidence-step p{color:#607780;margin:0}.evidence-step.highlight{border-top:4px solid #b28b32;background:#fffdf7}
</style>
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active=1 %]
            <span>Promotion &amp; Engagement</span>
        [% END %]
    [% END %]
[% END %]

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-10 col-sm-push-2">
            <main>
                <div id="toolbar" class="btn-toolbar">
                    <a class="btn btn-primary" href="?class=[% CLASS %]&method=[% METHOD %]&action=new_promotion">
                        <i class="fa fa-plus"></i> New promotion
                    </a>
                    <a class="btn btn-default" href="?class=[% CLASS %]&method=[% METHOD %]&action=promotions">
                        <i class="fa fa-list"></i> View promotions
                    </a>
                </div>

                <div class="promo-hero">
                    <div class="promo-kicker">Evidence-led library engagement</div>
                    <h1>Promotion &amp; Engagement</h1>
                    <p>Plan campaigns, connect promoted resources to Koha, and evaluate measurable circulation impact.</p>
                </div>

                [% IF success_message %]
                    <div class="alert alert-success">[% success_message | html %]</div>
                [% END %]
                [% IF warning_message %]
                    <div class="alert alert-warning">[% warning_message | html %]</div>
                [% END %]

                <h2 class="section-title">Institutional overview</h2>
                <div class="row">
                    <div class="col-md-2 col-sm-4"><div class="metric-card"><div class="metric-label">Campaigns</div><div class="metric-value">[% campaign_count %]</div><div class="metric-help">All current records</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card teal"><div class="metric-label">Active</div><div class="metric-value">[% active_count %]</div><div class="metric-help">Live activities</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card blue"><div class="metric-label">Completed</div><div class="metric-value">[% completed_count %]</div><div class="metric-help">Finished campaigns</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card"><div class="metric-label">Resources</div><div class="metric-value">[% item_count %]</div><div class="metric-help">Koha items linked</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card teal"><div class="metric-label">Locations</div><div class="metric-value">[% location_count %]</div><div class="metric-help">Configured displays</div></div></div>
                    <div class="col-md-2 col-sm-4"><div class="metric-card blue"><div class="metric-label">Measured checkouts</div><div class="metric-value">[% IF portfolio %][% portfolio.portfolio_checkout_count %][% ELSE %]0[% END %]</div><div class="metric-help">Attributed after promotion</div></div></div>
                </div>
                <div class="btn-group" style="margin-bottom:20px">
                    <a class="btn btn-primary" href="?class=[% CLASS %]&method=[% METHOD %]&action=analytics"><i class="fa fa-bar-chart"></i> Campaign analytics</a>
                    <a class="btn btn-default" href="?class=[% CLASS %]&method=[% METHOD %]&action=book_display_impact"><i class="fa fa-book"></i> Book Display Impact</a>
                    <a class="btn btn-default" href="?class=[% CLASS %]&method=[% METHOD %]&action=reports"><i class="fa fa-file-text-o"></i> Comparative reports</a>
                </div>

                <h2 class="section-title">How a book display becomes evidence</h2>
                <div class="row">
                    <div class="col-md-3"><div class="evidence-step"><span class="step-number">1</span><h3>Record the display</h3><p>Capture dates, location, audience and every promoted Koha barcode.</p></div></div>
                    <div class="col-md-3"><div class="evidence-step"><span class="step-number">2</span><h3>Establish the baseline</h3><p>Measure the same books in an equal period immediately before the display.</p></div></div>
                    <div class="col-md-3"><div class="evidence-step"><span class="step-number">3</span><h3>Observe response</h3><p>Track checkouts during the display and through the 60-day follow-up.</p></div></div>
                    <div class="col-md-3"><div class="evidence-step highlight"><span class="step-number">4</span><h3>Present the finding</h3><p>Show uplift and title-level response as evidence of circulation engagement.</p></div></div>
                </div>

                <div class="panel panel-default academic-panel">
                    <div class="panel-heading"><strong>Recent promotions</strong></div>
                    <div class="panel-body">
                        [% IF recent_campaigns && recent_campaigns.size %]
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Campaign</th>
                                            <th>Type</th>
                                            <th>Channel</th>
                                            <th>Start</th>
                                            <th>End</th>
                                            <th>Audience</th>
                                            <th>Status</th>
                                            <th>Evidence</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        [% FOREACH campaign IN recent_campaigns %]
                                            <tr>
                                                <td>
                                                    <a href="?class=[% CLASS %]&method=[% METHOD %]&action=promotion_detail&campaign_id=[% campaign.campaign_id %]">
                                                        [% campaign.name | html %]
                                                    </a>
                                                </td>
                                                <td>[% campaign.campaign_type_label | html %]</td>
                                                <td>[% campaign.channel_label | html %]</td>
                                                <td>[% campaign.start_date | html %]</td>
                                                <td>[% campaign.end_date | html %]</td>
                                                <td>[% campaign.target_audience | html %]</td>
                                                <td><span class="label label-default">[% campaign.status | html %]</span></td>
                                                <td><a class="btn btn-xs btn-default" href="?class=[% CLASS %]&method=[% METHOD %]&action=analytics&campaign_id=[% campaign.campaign_id %]"><i class="fa fa-line-chart"></i> View impact</a></td>
                                            </tr>
                                        [% END %]
                                    </tbody>
                                </table>
                            </div>
                        [% ELSE %]
                            <p class="text-muted">No promotions have been created yet.</p>
                        [% END %]
                    </div>
                </div>

                <div class="panel panel-default academic-panel">
                    <div class="panel-heading"><strong>Measurement framework</strong></div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-md-4"><strong>Koha authoritative data</strong><p class="text-muted">Catalogue, circulation, patron and branch information remain in Koha.</p></div>
                            <div class="col-md-4"><strong>Comparable time windows</strong><p class="text-muted">Equal baseline and campaign periods plus 7, 14, 30 and 60-day follow-up.</p></div>
                            <div class="col-md-4"><strong>Privacy by design</strong><p class="text-muted">General analytics remain aggregate-only and small borrower cohorts are suppressed.</p></div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
        <div class="col-sm-2 col-sm-pull-10">
            <aside>
                <div class="sidebar_menu">
                    <ul>
                        <li class="active"><a href="?class=[% CLASS %]&method=[% METHOD %]">Dashboard</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=new_promotion">New promotion</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=promotions">Promotions</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=analytics">Analytics</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=book_display_impact">Book Display Impact</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=reports">Reports</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</div>
[% INCLUDE 'intranet-bottom.inc' %]
