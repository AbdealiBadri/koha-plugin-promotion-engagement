[% USE raw %]
[% USE Koha %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: Promoted Resource Impact</title>
[% INCLUDE 'doc-head-close.inc' %]
<style>
.impact-hero{background:linear-gradient(135deg,#17324d,#245b64 70%,#2d7372);color:#fff;border-radius:9px;padding:25px 29px;margin-bottom:20px;box-shadow:0 5px 18px rgba(23,50,77,.2)}
.impact-hero h1{color:#fff;font-family:Georgia,serif;margin:0 0 7px}.impact-hero p{color:#dcebed;font-size:1.08rem;margin:0}.impact-kicker{color:#e2c675;text-transform:uppercase;letter-spacing:.12em;font-weight:700;font-size:.78rem}
.impact-card{background:#fff;border:1px solid #d9e2e6;border-radius:8px;padding:16px 18px;margin-bottom:18px;box-shadow:0 2px 9px rgba(23,50,77,.07);border-top:4px solid #2d7372}.impact-card.gold{border-top-color:#b28b32}.impact-card.blue{border-top-color:#3d6685}.impact-value{font-family:Georgia,serif;color:#17324d;font-size:2rem}.impact-label{color:#5a707a;text-transform:uppercase;font-size:.76rem;font-weight:700;letter-spacing:.04em}
.priority{display:inline-block;padding:4px 9px;border-radius:12px;font-weight:700}.priority-High{background:#f8d7da;color:#842029}.priority-Review{background:#fff3cd;color:#664d03}.priority-Monitor{background:#e2e3e5;color:#41464b}.evidence-Strong{color:#176b62;font-weight:700}.evidence-Moderate{color:#8a681d;font-weight:700}.evidence-Limited{color:#6c757d}
.impact-panel{border:1px solid #d9e2e6;border-radius:8px}.impact-panel>.panel-heading{background:#f1f5f6;color:#17324d;padding:13px 16px}.impact-panel th{background:#f8fafb;color:#294d5b;white-space:nowrap}.decision-box{min-width:245px}.decision-box input[type=number]{width:62px;display:inline-block}.decision-box textarea{width:100%;height:48px;margin:5px 0}.method-note{border-left:4px solid #b28b32;background:#fffdf7;padding:12px 15px;margin:15px 0}

/* Shared professional interaction treatment */
.btn-primary{background:#245b64!important;border-color:#1c4d55!important;color:#fff!important;font-weight:700;box-shadow:0 2px 5px rgba(23,50,77,.18)}
.btn-primary:hover,.btn-primary:focus{background:#17324d!important;border-color:#17324d!important;color:#fff!important}
.btn-default{background:#fff!important;border:1px solid #91a5ad!important;color:#17324d!important;font-weight:700;box-shadow:0 1px 3px rgba(23,50,77,.10)}
.btn-default:hover,.btn-default:focus{background:#edf4f4!important;border-color:#245b64!important;color:#102c43!important}
.btn-danger{color:#fff!important;font-weight:700}.btn i{margin-right:4px}
#toolbar,.btn-group,.export-bar{margin-bottom:18px}.table{background:#fff}.table>thead>tr>th{border-bottom:2px solid #9db2ba!important}
.table>tbody>tr:hover{background:#eef5f5!important}.table td,.table th{vertical-align:middle!important}
.sidebar_menu ul{border:1px solid #d8e1e5;border-radius:7px;overflow:hidden;background:#fff;box-shadow:0 2px 8px rgba(23,50,77,.06)}
.sidebar_menu ul li a{display:block;padding:11px 13px;color:#17324d!important;font-weight:700;border-left:4px solid transparent}
.sidebar_menu ul li a:hover,.sidebar_menu ul li a:focus{background:#edf4f4;text-decoration:none;border-left-color:#2d7372}
.sidebar_menu ul li.active a{background:#e5f0ef!important;color:#17324d!important;border-left-color:#2d7372!important}
.form-control:focus,input:focus,select:focus,textarea:focus{border-color:#2d7372!important;box-shadow:0 0 0 2px rgba(45,115,114,.15)!important}
.panel-heading strong{letter-spacing:.01em}.required{color:#8a2f39!important;font-weight:700}
</style>
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]
[% WRAPPER 'sub-header.inc' %]
 [% WRAPPER breadcrumbs %]
  [% WRAPPER breadcrumb_item %]<a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>[% END %]
  [% WRAPPER breadcrumb_item %]<a href="?class=[% CLASS %]&method=[% METHOD %]">Promotion &amp; Engagement</a>[% END %]
  [% WRAPPER breadcrumb_item bc_active=1 %]<span>Promoted Resource Impact</span>[% END %]
 [% END %]
[% END %]
<div class="container-fluid"><div class="row">
<div class="col-sm-10 col-sm-push-2"><main>
 <div class="impact-hero">
  <div class="impact-kicker">Promotion evidence to collection action</div>
  <h1>Promoted Resource Impact</h1>
  <p>See whether promoted titles are actually being borrowed, then review copy and hold pressure before sending approved additional-copy requests to Koha Suggestions.</p>
 </div>
 [% IF success_message %]<div class="alert alert-success">[% success_message | html %]</div>[% END %]
 [% IF error_message %]<div class="alert alert-danger">[% error_message | html %]</div>[% END %]
 <div class="panel panel-default impact-panel"><div class="panel-heading"><strong>Select a campaign</strong></div>
  <div class="panel-body">
   <form method="get">
    <input type="hidden" name="class" value="[% CLASS %]"><input type="hidden" name="method" value="[% METHOD %]">
    <input type="hidden" name="action" value="book_display_impact">
    <label for="campaign_id">Campaign</label>
    <select id="campaign_id" name="campaign_id" class="form-control" style="max-width:620px;display:inline-block">
     [% FOREACH campaign IN campaigns %]
      <option value="[% campaign.campaign_id %]"[% IF selected_id == campaign.campaign_id %] selected[% END %]>[% campaign.name | html %] ([% campaign.start_date | html %])</option>
     [% END %]
    </select>
    <button class="btn btn-primary" type="submit"><i class="fa fa-refresh"></i> Calculate impact</button>
    <p class="help-block" style="margin-top:10px"><strong>Select a campaign first.</strong> This screen combines title utilization, circulation response, copy availability and acquisition evidence. Active campaigns are measured through today.</p>
   </form>
  </div>
 </div>
 [% IF impact %]
 [% IF impact.analytics.analysis_period.live_to_date %]
  <div class="alert alert-info"><strong>Active campaign — live analytics through [% impact.analytics.analysis_period.as_of_date | html %].</strong> Results update without completing the campaign; future follow-up windows are shown as pending.</div>
 [% END %]
 <h2 style="color:#17324d;margin:8px 0 14px">Engagement at a glance</h2>
 <div class="row">
  <div class="col-md-2 col-sm-4"><div class="impact-card"><div class="impact-label">Promoted titles</div><div class="impact-value">[% impact.summary.title_count %]</div><small class="text-muted">Distinct bibliographic titles</small></div></div>
  <div class="col-md-2 col-sm-4"><div class="impact-card gold"><div class="impact-label">Titles borrowed</div><div class="impact-value">[% impact.summary.titles_used_display %]</div><small class="text-muted">Promoted titles with checkout response</small></div></div>
  <div class="col-md-2 col-sm-4"><div class="impact-card blue"><div class="impact-label">Title utilization</div><div class="impact-value">[% IF impact.summary.title_utilization_display %][% impact.summary.title_utilization_display %]%[% ELSE %]—[% END %]</div><small class="text-muted">Breadth of promoted collection used</small></div></div>
  <div class="col-md-2 col-sm-4"><div class="impact-card"><div class="impact-label">Campaign checkouts</div><div class="impact-value">[% impact.summary.during_checkout_display %]</div><small class="text-muted">Baseline: [% impact.summary.baseline_checkout_count %]</small></div></div>
  <div class="col-md-2 col-sm-4"><div class="impact-card gold"><div class="impact-label">Increased-use titles</div><div class="impact-value">[% impact.summary.titles_increased_display %]</div><small class="text-muted">Higher circulation than baseline</small></div></div>
  <div class="col-md-2 col-sm-4"><div class="impact-card blue"><div class="impact-label">Zero-response titles</div><div class="impact-value">[% impact.summary.zero_response_display %]</div><small class="text-muted">No checkout in measured campaign period</small></div></div>
 </div>
 <div class="panel panel-default impact-panel" style="margin-bottom:18px">
  <div class="panel-heading"><strong>Collection-development signals</strong></div>
  <div class="panel-body">
   <div class="row">
    <div class="col-md-3"><strong>High priority</strong><br><span class="impact-value">[% impact.summary.high_priority_count %]</span></div>
    <div class="col-md-3"><strong>Active holds</strong><br><span class="impact-value">[% impact.summary.active_holds %]</span></div>
    <div class="col-md-3"><strong>Approved</strong><br><span class="impact-value">[% impact.summary.approved_count %]</span></div>
    <div class="col-md-3"><strong>Sent to Koha</strong><br><span class="impact-value">[% impact.summary.submitted_count %]</span></div>
   </div>
  </div>
 </div>
 <div class="method-note"><strong>How recommendations work:</strong> promotion response and active holds are evidence, not automatic purchasing authority. The suggested quantity follows Koha's configured hold-ratio target per serviceable copy. A librarian must approve every request before Koha Suggestions receives it.</div>
 <div class="panel panel-default impact-panel"><div class="panel-heading"><strong>Promoted-title demand and additional-copy review</strong></div><div class="panel-body">
 [% IF impact.rows.size %]<div class="table-responsive"><table class="table table-striped table-hover">
 <thead><tr><th>Promoted book</th><th>Response</th><th>Copies</th><th>Demand</th><th>Evidence</th><th>Recommendation</th><th>Decision</th></tr></thead>
 <tbody>[% FOREACH item IN impact.rows %]<tr>
  <td><strong><a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=[% item.biblionumber %]">[% item.title | html %]</a></strong>[% IF item.author %]<br><span class="text-muted">[% item.author | html %]</span>[% END %]<br><small>Promoted barcode(s): [% item.barcodes.join(', ') | html %]</small></td>
  <td>Before: <strong>[% item.baseline_count %]</strong><br>During: <strong>[% item.during_count %]</strong><br>After 60 days: [% IF item.followup_complete %]<strong>[% item.after_60_count %]</strong>[% ELSE %]<span class="text-muted">Pending</span>[% END %]</td>
  <td>Total: [% item.total_copies %]<br>Serviceable: [% item.serviceable_copies %]<br>Available now: [% item.available_copies %]</td>
  <td>Active holds: <strong>[% item.active_holds %]</strong><br>Holds/copy: [% item.hold_ratio %]</td>
  <td><span class="priority priority-[% item.priority %]">[% item.priority %]</span><br><span class="evidence-[% item.evidence_grade %]">[% item.evidence_grade %] evidence</span></td>
  <td>[% IF item.purchase_signal %]<strong>Consider [% item.suggested_quantity %] additional cop[% IF item.suggested_quantity == 1 %]y[% ELSE %]ies[% END %]</strong>[% ELSE %]<strong>Monitor; no purchase signal yet</strong>[% END %]<br><small>[% item.recommendation_reason | html %]</small></td>
  <td class="decision-box">
   [% IF item.decision && item.decision.decision_status == 'submitted' %]
    <span class="label label-success">Sent to Koha</span><br>Suggestion #[% item.decision.koha_suggestion_id %]<br>
    <a href="/cgi-bin/koha/suggestion/suggestion.pl?suggestionid=[% item.decision.koha_suggestion_id %]&op=edit_form">Open Koha suggestion</a>
   [% ELSE %]
    <form method="post" action="/cgi-bin/koha/plugins/run.pl">
     <input type="hidden" name="class" value="[% CLASS | html %]"><input type="hidden" name="method" value="[% METHOD | html %]">
     <input type="hidden" name="csrf_token" value="[% Koha.GenerateCSRF | html %]">
     <input type="hidden" name="op" value="cud-save_impact_decision"><input type="hidden" name="action" value="book_display_impact">
     <input type="hidden" name="campaign_id" value="[% selected_id %]"><input type="hidden" name="biblionumber" value="[% item.biblionumber %]">
     <label>Quantity <input class="form-control input-sm" type="number" name="recommended_quantity" min="1" max="99" value="[% IF item.decision %][% item.decision.recommended_quantity %][% ELSE %][% item.suggested_quantity %][% END %]"></label>
     <textarea class="form-control input-sm" name="reviewer_note" placeholder="Optional review note">[% IF item.decision %][% item.decision.reviewer_note | html %][% END %]</textarea>
     <button class="btn btn-xs btn-success" name="decision_status" value="approved"><i class="fa fa-check"></i> Approve</button>
     <button class="btn btn-xs btn-default" name="decision_status" value="rejected"><i class="fa fa-times"></i> Reject</button>
    </form>
    [% IF item.decision && item.decision.decision_status == 'approved' %]
    <form method="post" action="/cgi-bin/koha/plugins/run.pl" style="margin-top:7px">
     <input type="hidden" name="class" value="[% CLASS | html %]"><input type="hidden" name="method" value="[% METHOD | html %]">
     <input type="hidden" name="csrf_token" value="[% Koha.GenerateCSRF | html %]"><input type="hidden" name="op" value="cud-submit_impact_suggestion">
     <input type="hidden" name="action" value="book_display_impact"><input type="hidden" name="campaign_id" value="[% selected_id %]"><input type="hidden" name="biblionumber" value="[% item.biblionumber %]">
     <button class="btn btn-xs btn-primary"><i class="fa fa-share"></i> Send to Koha Suggestions</button>
    </form>
    [% END %]
   [% END %]
  </td>
 </tr>[% END %]</tbody></table></div>
 [% ELSE %]<div class="alert alert-info">This campaign has no linked Koha books to assess.</div>[% END %]
 </div></div>
 <div class="alert alert-info"><strong>Responsible interpretation:</strong> checkout and hold data indicate demand and access pressure. They do not by themselves prove that the promotion caused every loan, and they do not replace professional collection-development judgment.</div>
 [% END %]
</main></div>
<div class="col-sm-2 col-sm-pull-10"><aside><div class="sidebar_menu"><ul>
 <li><a href="?class=[% CLASS %]&method=[% METHOD %]">Dashboard</a></li>
 <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=new_promotion">New promotion</a></li>
 <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=promotions">Promotions</a></li>
 <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=analytics">Analytics</a></li>
 <li class="active"><a href="?class=[% CLASS %]&method=[% METHOD %]&action=book_display_impact">Resource Impact</a></li>
 <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=reports">Reports</a></li>
 <li><a href="?class=[% CLASS %]&method=configure">Configuration</a></li>
</ul></div></aside></div>
</div></div>
[% INCLUDE 'intranet-bottom.inc' %]
