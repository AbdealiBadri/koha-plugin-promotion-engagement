[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: Promotion reports</title>
[% INCLUDE 'doc-head-close.inc' %]
<style>
.promo-hero{background:linear-gradient(135deg,#17324d,#245b64);color:#fff;border-radius:8px;padding:24px 28px;margin:0 0 20px;box-shadow:0 4px 14px rgba(23,50,77,.18)}
.promo-hero h1{color:#fff;margin:0 0 7px}.promo-hero p{margin:0;color:#dcebed;font-size:1.1rem}
.metric-card{background:#fff;border:1px solid #d8e1e5;border-top:4px solid #b28b32;border-radius:6px;padding:18px;min-height:112px;box-shadow:0 2px 8px rgba(23,50,77,.08);margin-bottom:18px}
.metric-label{color:#526b78;text-transform:uppercase;letter-spacing:.04em;font-size:.83rem;font-weight:700}
.metric-value{color:#17324d;font-family:Georgia,serif;font-size:2.3rem;line-height:1.2;margin-top:5px}
.report-panel{border:1px solid #d8e1e5;border-radius:6px;box-shadow:0 2px 8px rgba(23,50,77,.06);margin-bottom:20px}
.report-panel .panel-heading{background:#f1f5f6;border-bottom:1px solid #d8e1e5;color:#17324d;padding:13px 16px}
.report-panel table{margin-bottom:0}.report-panel th{color:#294d5b;background:#f8fafb}
.export-bar{margin:0 0 18px}.export-bar .btn{margin-right:6px;margin-bottom:6px}

/* Shared professional interaction treatment */
.btn-primary{background:#245b64!important;border-color:#1c4d55!important;color:#fff!important;font-weight:700;box-shadow:0 2px 5px rgba(23,50,77,.18)}
.btn-primary:hover,.btn-primary:focus{background:#17324d!important;border-color:#17324d!important;color:#fff!important}
.btn-default{background:#fff!important;border:1px solid #91a5ad!important;color:#17324d!important;font-weight:700;box-shadow:0 1px 3px rgba(23,50,77,.10)}
.btn-default:hover,.btn-default:focus{background:#edf4f4!important;border-color:#245b64!important;color:#102c43!important}
.btn-danger{color:#fff!important;font-weight:700}.btn i{margin-right:4px}
#toolbar,.btn-group,.export-bar{margin-bottom:18px}.table{background:#fff}.table>thead>tr>th{border-bottom:2px solid #9db2ba!important}
.table>tbody>tr:hover{background:#eef5f5!important}.table td,.table th{vertical-align:middle!important}
.sidebar_menu ul{border:1px solid #d8e1e5;border-radius:7px;overflow:hidden;background:#fff;box-shadow:0 2px 8px rgba(23,50,77,.06)}
.sidebar_menu ul li a{display:block;padding:11px 13px;color:#17324d!important;font-weight:700;border-left:4px solid transparent}
.sidebar_menu ul li a:hover,.sidebar_menu ul li a:focus{background:#edf4f4;text-decoration:none;border-left-color:#2d7372}
.sidebar_menu ul li.active a{background:#e5f0ef!important;color:#17324d!important;border-left-color:#2d7372!important}
.form-control:focus,input:focus,select:focus,textarea:focus{border-color:#2d7372!important;box-shadow:0 0 0 2px rgba(45,115,114,.15)!important}
.panel-heading strong{letter-spacing:.01em}.required{color:#8a2f39!important;font-weight:700}
</style>
[% INCLUDE "$PLUGIN_DIR/promoeng_ui_css.inc" %]
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]
[% WRAPPER 'sub-header.inc' %]
 [% WRAPPER breadcrumbs %]
  [% WRAPPER breadcrumb_item %]<a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>[% END %]
  [% WRAPPER breadcrumb_item %]<a href="?class=[% CLASS %]&method=[% METHOD %]">Promotion &amp; Engagement</a>[% END %]
  [% WRAPPER breadcrumb_item bc_active=1 %]<span>Reports</span>[% END %]
 [% END %]
[% END %]
<div class="container-fluid"><div class="row">
<div class="col-sm-10 col-sm-push-2"><main>
                [% SET promo_help_page = 'reports' %]
                [% INCLUDE "$PLUGIN_DIR/how_to_use.tt" %]
<div class="promo-hero">
 <h1>Promotion impact reports</h1>
 <p>Evidence-based comparisons across campaigns, channels and display locations.</p>
</div>
[% IF error_message %]<div class="alert alert-danger">[% error_message | html %]</div>[% END %]
<div class="panel panel-default report-panel">
 <div class="panel-heading"><strong>Choose what to compare</strong></div>
 <div class="panel-body">
  <form method="get" action="/cgi-bin/koha/plugins/run.pl">
   <input type="hidden" name="class" value="[% CLASS | html %]">
   <input type="hidden" name="method" value="[% METHOD | html %]">
   <input type="hidden" name="action" value="reports">
   <div class="row">
    <div class="col-md-4"><label for="report-campaign">Campaigns</label>
     <select id="report-campaign" name="campaign_ids" multiple class="form-control promo-searchable-select" data-natural-sort="1" data-placeholder="Type to search; leave empty for all campaigns">
      [% FOREACH campaign IN campaigns %]
       <option value="[% campaign.campaign_id %]"[% IF campaign.selected %] selected[% END %]>[% campaign.name | html %] ([% campaign.start_date | html %])</option>
      [% END %]
     </select>
     <p class="promo-dt-note">Select one or several campaigns. Leave empty to compare all campaigns that match the other filters.</p>
    </div>
    <div class="col-md-2"><label for="report-status">Status</label>
     <select id="report-status" name="status" class="form-control promo-searchable-select" data-placeholder="All statuses">
      <option value="">All statuses</option>
      <option value="draft"[% IF selected_status == 'draft' %] selected[% END %]>Draft</option>
      <option value="active"[% IF selected_status == 'active' %] selected[% END %]>Active</option>
      <option value="completed"[% IF selected_status == 'completed' %] selected[% END %]>Completed</option>
     </select>
    </div>
    <div class="col-md-2"><label for="date-from">From</label><input id="date-from" type="date" name="date_from" class="form-control" value="[% date_from | html %]"></div>
    <div class="col-md-2"><label for="date-to">To</label><input id="date-to" type="date" name="date_to" class="form-control" value="[% date_to | html %]"></div>
    <div class="col-md-2" style="padding-top:25px"><button class="btn btn-primary" type="submit"><i class="fa fa-filter"></i> Apply</button></div>
   </div>
   [% IF selected_campaign_ids.size || selected_status || date_from || date_to %]
    <div style="margin-top:12px"><a class="btn btn-default btn-sm" href="?class=[% CLASS %]&method=[% METHOD %]&action=reports"><i class="fa fa-times"></i> Clear filters</a></div>
   [% END %]
  </form>
 </div>
</div>
<div class="row">
 <div class="col-md-2 col-sm-4"><div class="metric-card"><div class="metric-label">Campaigns measured</div><div class="metric-value">[% campaign_count %]</div><div class="text-muted">Current report scope</div></div></div>
 <div class="col-md-2 col-sm-4"><div class="metric-card"><div class="metric-label">Promoted titles</div><div class="metric-value">[% IF portfolio %][% portfolio.promoted_title_count %][% ELSE %]0[% END %]</div><div class="text-muted">[% IF portfolio %][% portfolio.promoted_item_count %][% ELSE %]0[% END %] linked copies/items</div></div></div>
 <div class="col-md-2 col-sm-4"><div class="metric-card"><div class="metric-label">Titles Issued / Borrowed</div><div class="metric-value">[% IF portfolio %][% portfolio.titles_used_count %][% ELSE %]0[% END %]</div><div class="text-muted">Borrowed during campaign periods</div></div></div>
 <div class="col-md-2 col-sm-4"><div class="metric-card"><div class="metric-label">Title utilization</div><div class="metric-value">[% IF portfolio_utilization_display %][% portfolio_utilization_display %]%[% ELSE %]—[% END %]</div><div class="text-muted">Share of promoted titles issued/borrowed</div></div></div>
 <div class="col-md-2 col-sm-4"><div class="metric-card"><div class="metric-label">Campaign checkouts</div><div class="metric-value">[% IF portfolio %][% portfolio.portfolio_campaign_checkout_count %][% ELSE %]0[% END %]</div><div class="text-muted">De-duplicated issue events</div></div></div>
 <div class="col-md-2 col-sm-4"><div class="metric-card"><div class="metric-label">Baseline checkouts</div><div class="metric-value">[% IF portfolio %][% portfolio.portfolio_baseline_checkout_count %][% ELSE %]0[% END %]</div><div class="text-muted">Equal pre-promotion periods</div></div></div>
</div>
<div class="panel panel-default report-panel">
 <div class="panel-heading"><strong>Measurement quality</strong></div>
 <div class="panel-body">
  <strong>[% IF portfolio %][% portfolio.portfolio_checkout_count %][% ELSE %]0[% END %]</strong> de-duplicated checkout event(s) fall within campaign-plus-follow-up attribution windows.
  <strong>[% IF portfolio %][% portfolio.multi_attributed_issue_count %][% ELSE %]0[% END %]</strong> event(s) match more than one campaign and are flagged as multi-attributed rather than double-counted in portfolio totals.
 </div>
</div>
[% IF portfolio && portfolio.campaign_results.size %]
<div class="promo-section-card">
 <div class="promo-section-head">
  <div><h3>Campaign-by-campaign comparison</h3><span class="promo-muted-academic">Compare the selected campaigns directly before reviewing grouped channel/type/audience views.</span></div>
  <div class="promo-view-toggle">
   <button type="button" class="btn btn-default active" data-promo-view-group="report-campaign-table" data-promo-view-show="#report-campaign-chart-view"><i class="fa fa-bar-chart"></i> Chart View</button>
   <button type="button" class="btn btn-default" data-promo-view-group="report-campaign-table" data-promo-view-show="#report-campaign-table-view"><i class="fa fa-table"></i> Table View</button>
  </div>
 </div>
 <div class="promo-section-body">
  <div id="report-campaign-chart-view" class="promo-view-panel is-active" data-promo-view-panel="report-campaign-table">
   <div class="promo-chart-card">
    <h3>Baseline vs Campaign Checkouts</h3>
    <p>Each pair compares the same promoted resources before and during that campaign.</p>
    <div id="report-campaign-chart" class="promo-chart"></div>
    <div class="promo-chart-actions"><button type="button" class="btn btn-default btn-sm" onclick="promoDownloadChartJpeg('report-campaign-chart','campaign-by-campaign-comparison')"><i class="fa fa-download"></i> Download JPEG</button></div>
   </div>
  </div>
  <div id="report-campaign-table-view" class="promo-view-panel" data-promo-view-panel="report-campaign-table">
   <div class="table-responsive">
    <table id="report-campaign-table" class="table table-striped table-hover promo-data-table" data-page-length="25" data-order-column="6" data-order-direction="desc">
     <thead><tr><th>Campaign</th><th>Status</th><th>Promoted titles</th><th>Titles Issued / Borrowed</th><th>Utilization</th><th>Baseline checkouts</th><th>Campaign checkouts</th><th>Change</th><th>Zero response</th></tr></thead>
     <tbody>
      [% FOREACH result IN portfolio.campaign_results %]
       <tr>
        <td><strong>[% result.campaign.name | html %]</strong><br><small class="text-muted">[% result.campaign.start_date | html %][% IF result.campaign.end_date %] → [% result.campaign.end_date | html %][% ELSIF result.analysis_period.live_to_date %] → today[% END %]</small></td>
        <td>[% result.campaign.status | html %][% IF result.analysis_period.live_to_date %]<br><small class="text-muted">live to date</small>[% END %]</td>
        <td>[% result.promoted_title_count %]<br><small class="text-muted">[% result.eligible_item_count %] copy/item record(s)</small></td>
        <td>[% result.titles_used_display %]</td>
        <td>[% IF result.title_utilization_display %][% result.title_utilization_display %]%[% ELSE %]—[% END %]</td>
        <td>[% result.baseline_checkout_count %]</td>
        <td>[% result.campaign_checkout_display %]</td>
        <td>[% IF result.uplift_display %][% result.uplift_display %]%[% ELSIF result.new_response %]New response[% ELSE %]—[% END %]</td>
        <td>[% result.zero_response_display %]</td>
       </tr>
      [% END %]
     </tbody>
    </table>
   </div>
  </div>
 </div>
</div>
[% END %]
<div class="export-bar">
 <strong>Download:</strong>
 <a class="btn btn-default btn-sm" href="?class=[% CLASS %]&method=[% METHOD %]&action=report_export&dimension=channel&format=csv[% IF filter_query %]&[% filter_query | html %][% END %]"><i class="fa fa-download"></i> Channel CSV</a>
 <a class="btn btn-default btn-sm" href="?class=[% CLASS %]&method=[% METHOD %]&action=report_export&dimension=location&format=csv[% IF filter_query %]&[% filter_query | html %][% END %]"><i class="fa fa-download"></i> Location CSV</a>
 <a class="btn btn-default btn-sm" href="?class=[% CLASS %]&method=[% METHOD %]&action=report_export&dimension=campaign_type&format=json[% IF filter_query %]&[% filter_query | html %][% END %]"><i class="fa fa-code"></i> Type JSON</a>
</div>
<div class="panel report-panel">
 <div class="panel-heading"><strong>Display-location evidence</strong></div>
 <div class="panel-body">
  [% IF leading_location %]
   <p><span class="label label-success">Leading single-location evidence</span></p>
   <h3 style="color:#17324d;margin-top:8px">[% leading_location.label | html %]</h3>
   <p><strong>[% leading_location.exclusive_checkout_count %]</strong> measured checkout(s) from <strong>[% leading_location.exclusive_campaign_count %]</strong> campaign(s) assigned only to this location.</p>
  [% ELSE %]
   <p class="text-muted">No single-location campaign has enough checkout evidence to name a leading display location yet.</p>
  [% END %]
  <p class="text-muted"><i class="fa fa-info-circle"></i> A campaign assigned to several locations cannot prove at which physical point a reader discovered or picked up a book. Such campaigns remain in the comparison table but are excluded from the “leading location” statement.</p>
 </div>
</div>
[% BLOCK comparison_table %]
<div class="promo-section-card">
 <div class="promo-section-head">
  <div><h3>[% heading %]</h3><span class="promo-muted-academic">Chart and table views use the same comparison data.</span></div>
  <div class="promo-view-toggle">
   <button type="button" class="btn btn-default active" data-promo-view-group="[% table_id %]" data-promo-view-show="#[% chart_id %]-view"><i class="fa fa-bar-chart"></i> Chart View</button>
   <button type="button" class="btn btn-default" data-promo-view-group="[% table_id %]" data-promo-view-show="#[% table_id %]-view"><i class="fa fa-table"></i> Table View</button>
  </div>
 </div>
 <div class="promo-section-body">
  <div id="[% chart_id %]-view" class="promo-view-panel is-active" data-promo-view-panel="[% table_id %]">
   <div class="promo-chart-card">
    <h3>Baseline vs Campaign Checkouts</h3>
    <p>Compares the same promoted resources before and during promotion for each configured value.</p>
    <div id="[% chart_id %]" class="promo-chart"></div>
    <div class="promo-chart-actions"><button type="button" class="btn btn-default btn-sm" onclick="promoDownloadChartJpeg('[% chart_id %]','[% chart_filename %]')"><i class="fa fa-download"></i> Download JPEG</button></div>
   </div>
  </div>
  <div id="[% table_id %]-view" class="promo-view-panel" data-promo-view-panel="[% table_id %]">
   <p class="promo-muted-academic"><i class="fa fa-info-circle"></i> Search any value, click a column heading to sort ascending/descending, and use <strong>Export → Excel</strong> for spreadsheet analysis.</p>
   <div class="table-responsive"><table id="[% table_id %]" class="table table-striped table-hover promo-data-table" data-page-length="25" data-order-column="6" data-order-direction="desc">
    <thead><tr><th>Configured value</th><th>Campaigns</th><th>Promoted titles</th><th>Titles Issued / Borrowed</th><th>Utilization</th><th>Baseline checkouts</th><th>Campaign checkouts</th><th>Change</th><th>Zero response</th><th>Titles with Increased Issues</th>[% IF show_location %]<th>Single-location checkouts</th><th>Single-location campaigns</th>[% END %]<th>Multi-location</th></tr></thead>
    <tbody>
    [% IF rows.size %]
     [% FOREACH row IN rows %]
     <tr>
      <td><strong>[% row.label | html %]</strong><br><small class="text-muted">[% row.code | html %]</small></td>
      <td>[% row.campaign_count %]</td>
      <td>[% row.promoted_title_count %]<br><small class="text-muted">[% row.eligible_item_count %] copy/item record(s)</small></td>
      <td>[% row.titles_used_count %]</td>
      <td>[% IF row.title_utilization_rate %][% row.title_utilization_rate %]%[% ELSE %]—[% END %]</td>
      <td>[% row.baseline_checkout_count %]</td>
      <td>[% row.checkout_count %]</td>
      <td>[% IF row.checkout_change_percent %][% row.checkout_change_percent %]%[% ELSIF row.baseline_checkout_count == 0 && row.checkout_count > 0 %]New response[% ELSE %]—[% END %]</td>
      <td>[% row.zero_response_title_count %]</td>
      <td>[% row.titles_increased_count %]</td>
      [% IF show_location %]<td>[% row.exclusive_checkout_count %]</td><td>[% row.exclusive_campaign_count %]</td>[% END %]
      <td>[% row.multi_location_campaign_count %]</td>
     </tr>
     [% END %]
    [% ELSE %]<tr><td colspan="[% IF show_location %]13[% ELSE %]11[% END %]" class="text-muted">No measurable records for this dimension.</td></tr>[% END %]
    </tbody>
   </table></div>
  </div>
 </div>
</div>
[% END %]
[% PROCESS comparison_table heading='Performance by channel' rows=channel_rows table_id='report-channel-table' chart_id='report-channel-chart' chart_filename='promotion-performance-by-channel' %]
[% PROCESS comparison_table heading='Performance by location' rows=location_rows show_location=1 table_id='report-location-table' chart_id='report-location-chart' chart_filename='promotion-performance-by-location' %]
[% PROCESS comparison_table heading='Performance by campaign type' rows=type_rows table_id='report-type-table' chart_id='report-type-chart' chart_filename='promotion-performance-by-campaign-type' %]
[% PROCESS comparison_table heading='Performance by language' rows=language_rows table_id='report-language-table' chart_id='report-language-chart' chart_filename='promotion-performance-by-language' %]
[% PROCESS comparison_table heading='Performance by audience' rows=audience_rows table_id='report-audience-table' chart_id='report-audience-chart' chart_filename='promotion-performance-by-audience' %]
<div class="alert alert-info"><strong>Interpretation note:</strong> Portfolio totals de-duplicate checkout issue IDs. Multi-location campaigns may appear under every linked location and are labelled explicitly.</div>
</main></div>
<div class="col-sm-2 col-sm-pull-10"><aside><div class="sidebar_menu"><ul>
 <li><a href="?class=[% CLASS %]&method=[% METHOD %]">Dashboard</a></li>
 <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=new_promotion">New promotion</a></li>
 <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=promotions">Promotions</a></li>
 <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=analytics">Analytics</a></li>
                        <li><a href="?class=[% CLASS %]&method=[% METHOD %]&action=book_display_impact">Resource Impact</a></li>
 <li class="active"><a href="?class=[% CLASS %]&method=[% METHOD %]&action=reports">Reports</a></li>
 <li><a href="?class=[% CLASS %]&method=configure">Configuration</a></li>
</ul></div></aside></div>
</div></div>
[% MACRO jsinclude BLOCK %]
    [% INCLUDE "$PLUGIN_DIR/promoeng_ui_js.inc" %]
    <script>
        $(document).ready(function(){
            promoChartFromComparisonTable("#report-campaign-table","report-campaign-chart");
            promoChartFromComparisonTable("#report-channel-table","report-channel-chart");
            promoChartFromComparisonTable("#report-location-table","report-location-chart");
            promoChartFromComparisonTable("#report-type-table","report-type-chart");
            promoChartFromComparisonTable("#report-language-table","report-language-chart");
            promoChartFromComparisonTable("#report-audience-table","report-audience-chart");
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
