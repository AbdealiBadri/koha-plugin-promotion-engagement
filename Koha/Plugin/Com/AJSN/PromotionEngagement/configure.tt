[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]

[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: Configure Promotion &amp; Engagement</title>
[% INCLUDE 'doc-head-close.inc' %]
<style>
main>h1{font-family:Georgia,serif;color:#17324d}main>.lead{color:#58717c;max-width:920px}
.panel-default{border-color:#d8e1e5;border-radius:6px;box-shadow:0 2px 8px rgba(23,50,77,.05)}
.panel-default>.panel-heading{background:#f1f5f6;color:#17324d;border-color:#d8e1e5;padding:12px 15px}
.table>thead>tr>th{background:#f8fafb;color:#294d5b}.btn-primary{background:#245b64;border-color:#1c4d55}.btn-primary:hover{background:#17324d;border-color:#17324d}

/* Shared professional interaction treatment */
.btn-primary{background:#245b64!important;border-color:#1c4d55!important;color:#fff!important;font-weight:700;box-shadow:0 2px 5px rgba(23,50,77,.18)}
.btn-primary:hover,.btn-primary:focus{background:#17324d!important;border-color:#17324d!important;color:#fff!important}
.btn-default{background:#fff!important;border:1px solid #91a5ad!important;color:#17324d!important;font-weight:700;box-shadow:0 1px 3px rgba(23,50,77,.10)}
.btn-default:hover,.btn-default:focus{background:#edf4f4!important;border-color:#245b64!important;color:#102c43!important}
.btn-danger{color:#fff!important;font-weight:700}.btn i{margin-right:4px}
#toolbar,.btn-group,.export-bar{margin-bottom:18px}.table{background:#fff}.table>thead>tr>th{border-bottom:2px solid #9db2ba!important}
.table>tbody>tr:hover{background:#eef5f5!important}.table td,.table th{vertical-align:middle!important}
.sidebar_menu ul{border:1px solid #d8e1e5;border-radius:7px;overflow:hidden;background:#fff;box-shadow:0 2px 8px rgba(23,50,77,.06)}
.sidebar_menu ul li a{display:block;padding:11px 13px;color:#17324d!important;font-weight:700;border-left:4px solid transparent}
.sidebar_menu ul li a:hover,.sidebar_menu ul li a:focus{background:#edf4f4;text-decoration:none;border-left-color:#2d7372}
.sidebar_menu ul li.active a{background:#e5f0ef!important;color:#17324d!important;border-left-color:#2d7372!important}
.form-control:focus,input:focus,select:focus,textarea:focus{border-color:#2d7372!important;box-shadow:0 0 0 2px rgba(45,115,114,.15)!important}
.panel-heading strong{letter-spacing:.01em}.required{color:#8a2f39!important;font-weight:700}
</style>
[% INCLUDE "$PLUGIN_DIR/promoeng_ui_css.inc" %]
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-10 col-sm-push-2">
            <main>
                [% SET promo_help_page = 'configuration' %]
                [% INCLUDE "$PLUGIN_DIR/how_to_use.tt" %]
                <h1>Promotion &amp; Engagement configuration</h1>
                <p class="lead">Manage reusable promotion values without changing Koha core data.</p>

                [% IF success_message %]
                    <div class="alert alert-success">[% success_message | html %]</div>
                [% END %]

                [% IF errors.size %]
                    <div class="alert alert-danger">
                        <h2>Configuration not saved</h2>
                        <ul>
                            [% FOREACH error IN errors %]
                                <li>[% error | html %]</li>
                            [% END %]
                        </ul>
                    </div>
                [% END %]

                <div class="panel panel-default">
                    <div class="panel-heading"><strong>Add or update a reusable value</strong></div>
                    <div class="panel-body">
                        <form method="post" action="/cgi-bin/koha/plugins/run.pl">
                            <input type="hidden" name="class" value="[% CLASS | html %]">
                            <input type="hidden" name="method" value="configure">
                            <input type="hidden" name="op" value="cud-save_vocab_value">
                            <input type="hidden" name="csrf_token" value="[% Koha.GenerateCSRF | html %]">

                            <fieldset class="rows">
                                <ol>
                                    <li>
                                        <label for="dimension">Dimension:</label>
                                        <select name="dimension" id="dimension" class="promo-searchable-select" data-natural-sort="1" data-placeholder="Search configuration dimension" required>
                                            <option value="">Select</option>
                                            [% FOREACH group IN vocabulary_groups %]
                                                <option value="[% group.dimension | html %]">[% group.label | html %]</option>
                                            [% END %]
                                        </select>
                                    </li>
                                    <li>
                                        <label for="value_code">Stable code:</label>
                                        <input type="text" name="value_code" id="value_code" maxlength="80" required>
                                        <span class="hint">Lowercase letters, numbers, underscore and hyphen only. Reusing the same dimension + code updates that value.</span>
                                    </li>
                                    <li>
                                        <label for="label">Display label:</label>
                                        <input type="text" name="label" id="label" maxlength="255" required>
                                    </li>
                                    <li>
                                        <label for="sort_order">Sort order:</label>
                                        <input type="number" name="sort_order" id="sort_order" min="0" max="9999" value="100" required>
                                    </li>
                                    <li>
                                        <label for="is_active">Active:</label>
                                        <input type="checkbox" name="is_active" id="is_active" value="1" checked>
                                    </li>
                                </ol>
                            </fieldset>
                            <fieldset class="action">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-save"></i> Save configuration value
                                </button>
                            </fieldset>
                        </form>
                    </div>
                </div>

                [% FOREACH group IN vocabulary_groups %]
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <strong>[% group.label | html %]</strong>
                            <span class="text-muted">([% group.dimension | html %])</span>
                        </div>
                        <div class="panel-body">
                            [% IF group.values.size %]
                                <table id="config-[% group.dimension | html %]-table" class="table table-striped table-bordered promo-data-table" data-page-length="25" data-order-column="2" data-order-direction="asc">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Label</th>
                                            <th>Sort</th>
                                            <th>Status</th>
                                            <th class="no-export">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        [% FOREACH value IN group.values %]
                                            <tr>
                                                <td><code>[% value.value_code | html %]</code></td>
                                                <td>[% value.label | html %]</td>
                                                <td>[% value.sort_order | html %]</td>
                                                <td>
                                                    [% IF value.is_active %]
                                                        <span class="label label-success">Active</span>
                                                    [% ELSE %]
                                                        <span class="label label-default">Disabled</span>
                                                    [% END %]
                                                </td>
                                                <td class="no-export">
                                                    <form method="post" action="/cgi-bin/koha/plugins/run.pl" style="display:inline">
                                                        <input type="hidden" name="class" value="[% CLASS | html %]">
                                                        <input type="hidden" name="method" value="configure">
                                                        <input type="hidden" name="op" value="cud-toggle_vocab_value">
                                                        <input type="hidden" name="vocab_value_id" value="[% value.vocab_value_id %]">
                                                        <input type="hidden" name="csrf_token" value="[% Koha.GenerateCSRF | html %]">
                                                        [% IF value.is_active %]
                                                            <input type="hidden" name="set_active" value="0">
                                                            <button type="submit" class="btn btn-default btn-xs">Disable</button>
                                                        [% ELSE %]
                                                            <input type="hidden" name="set_active" value="1">
                                                            <button type="submit" class="btn btn-default btn-xs">Enable</button>
                                                        [% END %]
                                                    </form>
                                                </td>
                                            </tr>
                                        [% END %]
                                    </tbody>
                                </table>
                            [% ELSE %]
                                <p class="text-muted">No values configured yet.</p>
                            [% END %]
                        </div>
                    </div>
                [% END %]

                <div class="alert alert-info">
                    <strong>Design rule:</strong> these values belong to the plugin, not Koha core. Locations configured here are promotion locations and may represent physical display points, signage points or digital placements.
                </div>

                <p class="text-muted">
                    Plugin version [% plugin_version | html %] · REST namespace <code>/api/v1/contrib/[% api_namespace | html %]</code>
                </p>
            </main>
        </div>

        <div class="col-sm-2 col-sm-pull-10">
            <aside>
                <div class="sidebar_menu">
                    <ul>
                        <li><a href="?class=[% CLASS %]&method=tool">Dashboard</a></li>
                        <li><a href="?class=[% CLASS %]&method=tool&action=new_promotion">New promotion</a></li>
                        <li><a href="?class=[% CLASS %]&method=tool&action=promotions">Promotions</a></li>
                        <li><a href="?class=[% CLASS %]&method=tool&action=analytics">Analytics</a></li>
                        <li><a href="?class=[% CLASS %]&method=tool&action=book_display_impact">Resource Impact</a></li>
                        <li><a href="?class=[% CLASS %]&method=tool&action=reports">Reports</a></li>
                        <li class="active"><a href="?class=[% CLASS %]&method=configure">Configuration</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</div>

[% MACRO jsinclude BLOCK %]
    [% INCLUDE "$PLUGIN_DIR/promoeng_ui_js.inc" %]
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
