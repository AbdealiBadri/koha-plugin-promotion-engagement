[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]

[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: Configure Promotion &amp; Engagement</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-10 col-sm-push-2">
            <main>
                <h1>Promotion &amp; Engagement configuration</h1>
                <p class="lead">Manage reusable promotion values without changing Koha core data.</p>

                [% IF success_message %]
                    <div class="alert alert-success">[% success_message | html %]</div>
                [% END %]

                [% IF errors.size %]
                    <div class="alert alert-danger">
                        <h2>Configuration not saved</h2>
                        <ul>
                            [% FOREACH error IN errors %]
                                <li>[% error | html %]</li>
                            [% END %]
                        </ul>
                    </div>
                [% END %]

                <div class="panel panel-default">
                    <div class="panel-heading"><strong>Add or update a reusable value</strong></div>
                    <div class="panel-body">
                        <form method="post" action="/cgi-bin/koha/plugins/run.pl">
                            <input type="hidden" name="class" value="[% CLASS | html %]">
                            <input type="hidden" name="method" value="configure">
                            <input type="hidden" name="op" value="cud-save_vocab_value">
                            <input type="hidden" name="csrf_token" value="[% Koha.GenerateCSRF | html %]">

                            <fieldset class="rows">
                                <ol>
                                    <li>
                                        <label for="dimension">Dimension:</label>
                                        <select name="dimension" id="dimension" required>
                                            <option value="">Select</option>
                                            [% FOREACH group IN vocabulary_groups %]
                                                <option value="[% group.dimension | html %]">[% group.label | html %]</option>
                                            [% END %]
                                        </select>
                                    </li>
                                    <li>
                                        <label for="value_code">Stable code:</label>
                                        <input type="text" name="value_code" id="value_code" maxlength="80" required>
                                        <span class="hint">Lowercase letters, numbers, underscore and hyphen only. Reusing the same dimension + code updates that value.</span>
                                    </li>
                                    <li>
                                        <label for="label">Display label:</label>
                                        <input type="text" name="label" id="label" maxlength="255" required>
                                    </li>
                                    <li>
                                        <label for="sort_order">Sort order:</label>
                                        <input type="number" name="sort_order" id="sort_order" min="0" max="9999" value="100" required>
                                    </li>
                                    <li>
                                        <label for="is_active">Active:</label>
                                        <input type="checkbox" name="is_active" id="is_active" value="1" checked>
                                    </li>
                                </ol>
                            </fieldset>
                            <fieldset class="action">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-save"></i> Save configuration value
                                </button>
                            </fieldset>
                        </form>
                    </div>
                </div>

                [% FOREACH group IN vocabulary_groups %]
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <strong>[% group.label | html %]</strong>
                            <span class="text-muted">([% group.dimension | html %])</span>
                        </div>
                        <div class="panel-body">
                            [% IF group.values.size %]
                                <table class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Label</th>
                                            <th>Sort</th>
                                            <th>Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        [% FOREACH value IN group.values %]
                                            <tr>
                                                <td><code>[% value.value_code | html %]</code></td>
                                                <td>[% value.label | html %]</td>
                                                <td>[% value.sort_order | html %]</td>
                                                <td>
                                                    [% IF value.is_active %]
                                                        <span class="label label-success">Active</span>
                                                    [% ELSE %]
                                                        <span class="label label-default">Disabled</span>
                                                    [% END %]
                                                </td>
                                                <td>
                                                    <form method="post" action="/cgi-bin/koha/plugins/run.pl" style="display:inline">
                                                        <input type="hidden" name="class" value="[% CLASS | html %]">
                                                        <input type="hidden" name="method" value="configure">
                                                        <input type="hidden" name="op" value="cud-toggle_vocab_value">
                                                        <input type="hidden" name="vocab_value_id" value="[% value.vocab_value_id %]">
                                                        <input type="hidden" name="csrf_token" value="[% Koha.GenerateCSRF | html %]">
                                                        [% IF value.is_active %]
                                                            <input type="hidden" name="set_active" value="0">
                                                            <button type="submit" class="btn btn-default btn-xs">Disable</button>
                                                        [% ELSE %]
                                                            <input type="hidden" name="set_active" value="1">
                                                            <button type="submit" class="btn btn-default btn-xs">Enable</button>
                                                        [% END %]
                                                    </form>
                                                </td>
                                            </tr>
                                        [% END %]
                                    </tbody>
                                </table>
                            [% ELSE %]
                                <p class="text-muted">No values configured yet.</p>
                            [% END %]
                        </div>
                    </div>
                [% END %]

                <div class="alert alert-info">
                    <strong>Design rule:</strong> these values belong to the plugin, not Koha core. Locations configured here are promotion locations and may represent physical display points, signage points or digital placements.
                </div>

                <p class="text-muted">
                    Plugin version [% plugin_version | html %] · REST namespace <code>/api/v1/contrib/[% api_namespace | html %]</code>
                </p>
            </main>
        </div>

        <div class="col-sm-2 col-sm-pull-10">
            <aside>
                <div id="navmenu">
                    <ul>
                        <li><a href="?class=[% CLASS %]&method=tool">Dashboard</a></li>
                        <li><a href="?class=[% CLASS %]&method=tool&action=new_promotion">New promotion</a></li>
                        <li><a href="?class=[% CLASS %]&method=tool&action=promotions">Promotions</a></li>
                        <li class="active"><a href="?class=[% CLASS %]&method=configure">Configuration</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</div>

[% INCLUDE 'intranet-bottom.inc' %]
